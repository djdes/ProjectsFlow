diff --git a/worker-github-sync.ps1 b/worker-github-sync.ps1
new file mode 100644
--- /dev/null
+++ b/worker-github-sync.ps1
@@ -0,0 +1,31 @@
+﻿# Shared instructions appended by the native runtime for every new/resumed worker.
+function Add-WorkerGitHubSyncInstructions([string]$Prompt) {
+  $rule = @'
+
+## Обязательная проверка GitHub при каждом запуске
+
+Для git-проекта перед анализом кода, началом ИЛИ продолжением задачи, а также
+перед commit, PR и push ОБЯЗАТЕЛЬНО выполняй `git fetch <github-remote> --prune`.
+Определи фактический remote GitHub, соответствующий проверенному репозиторию
+проекта. Не считай `origin` GitHub автоматически: он может указывать на сервер.
+Не добавляй и не подменяй remote в обход границ назначенного проекта.
+
+После fetch сравни HEAD с актуальной основной и рабочей ветками GitHub.
+Интегрируй удалённые изменения безопасно, прежде чем продолжать разработку или
+публиковать. Используй ветки и checkout только по правилам проекта и диспетчера.
+Сохраняй чужие и исходные незакоммиченные правки. Запрещены force-push,
+`reset --hard`, `clean` и отбрасывание файлов ради синхронизации. При конфликте
+без понятного безопасного разрешения сообщи конкретный блокер, сохранив правки.
+После интеграции повтори затронутые проверки.
+
+После push проверь через `git ls-remote`, что GitHub содержит опубликованный
+коммит. Если fetch, интеграция, проверка или push не удались, явно сообщи причину;
+не называй репозиторий синхронизированным и публикацию успешной без проверки.
+Проверка GitHub обязательна и при возобновлении старой сессии, независимо от
+предыдущего контекста и флага IGNORE_CLAUDE_MD.
+
+В snapshot-режиме, в проекте без Git и в заданиях без доступа к инструментам
+git-команды неприменимы: не создавай репозиторий или remote ради этого правила.
+'@
+  return $Prompt + "`n`n" + $rule
+}
diff --git a/worker-github-sync.tests.ps1 b/worker-github-sync.tests.ps1
new file mode 100644
--- /dev/null
+++ b/worker-github-sync.tests.ps1
@@ -0,0 +1,28 @@
+﻿$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'worker-github-sync.ps1')
+$checks = 0
+function Check([bool]$ok, [string]$message) {
+  if (-not $ok) { throw $message }
+  $script:checks++; Write-Host "PASS $message"
+}
+foreach ($prompt in @('New task', 'Resume the existing task', '<!-- worker-github-sync-v1 --> task text')) {
+  $result = Add-WorkerGitHubSyncInstructions $prompt
+  Check ($result.StartsWith($prompt)) 'the task prompt is preserved'
+  Check ($result.Contains('git fetch <github-remote> --prune')) 'GitHub fetch is required for every prompt, including resumes'
+  Check ($result.Contains('git ls-remote')) 'publication must be verified remotely'
+  Check ($result.Contains('IGNORE_CLAUDE_MD')) 'legacy template flags cannot waive synchronization'
+  Check ($result.Contains('snapshot-режиме')) 'snapshot and tool-less jobs keep their exception'
+}
+$errors = $null; $tokens = $null
+$engine = [Management.Automation.Language.Parser]::ParseFile((Join-Path $PSScriptRoot 'codex-engine.psm1'), [ref]$tokens, [ref]$errors)
+Check ($errors.Count -eq 0) 'the native runtime parses'
+$invoke = $engine.Find({ param($node) $node -is [Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -eq 'Invoke-CodexRawStream' }, $true)
+$calls = @($invoke.FindAll({ param($node) $node -is [Management.Automation.Language.CommandAst] -and $node.GetCommandName() -eq 'Add-WorkerGitHubSyncInstructions' }, $true))
+Check ($calls.Count -eq 1) 'the runtime always adds the rule once per invocation'
+$ancestor = $calls[0].Parent; $conditional = $false
+while ($ancestor -and $ancestor -ne $invoke) {
+  if ($ancestor -is [Management.Automation.Language.IfStatementAst]) { $conditional = $true }
+  $ancestor = $ancestor.Parent
+}
+Check (-not $conditional) 'the rule also covers workers without SessionTaskId'
+Write-Host "Passed: $checks"
