diff --git a/worker-git-policy.ps1 b/worker-git-policy.ps1
new file mode 100644
index 0000000..a8ca917
--- /dev/null
+++ b/worker-git-policy.ps1
@@ -0,0 +1,110 @@
+﻿# A lease spans the native worker process. Different tasks/dispatchers cannot write
+# the same checkout concurrently. Hooks are scoped to this child, never git config.
+function Enter-WorkerCheckoutLease([string]$Repo) {
+  if (-not (Test-Path -LiteralPath (Join-Path $Repo '.git'))) { return $null }
+  $gitDir = & git -C $Repo rev-parse --absolute-git-dir 2>$null
+  if ($LASTEXITCODE -ne 0) { throw 'worker_checkout_git_directory_unavailable' }
+  try { return [IO.File]::Open((Join-Path ([string]$gitDir).Trim() 'projectsflow-worker.lock'), [IO.FileMode]::OpenOrCreate, [IO.FileAccess]::ReadWrite, [IO.FileShare]::None) }
+  catch { throw 'worker_checkout_busy: another worker owns this project checkout; retry after it finishes' }
+}
+
+function ConvertTo-WorkerHookArgument([string]$Value) {
+  return "'" + $Value.Replace("'", "'\''") + "'"
+}
+
+function New-WorkerGitPolicy([string]$Repo, [string]$TaskId, [string]$Directory) {
+  if (-not (Test-Path -LiteralPath (Join-Path $Repo '.git'))) { return $null }
+  if ($TaskId -notmatch '^[0-9a-fA-F]{8}-[0-9a-fA-F-]{27}$') { throw 'worker_git_policy_invalid_task_id' }
+  $gitDir = [string](& git -C $Repo rev-parse --absolute-git-dir 2>$null)
+  if ($LASTEXITCODE -ne 0) { throw 'worker_checkout_git_directory_unavailable' }
+  $original = [string](& git -C $Repo config --get core.hooksPath 2>$null)
+  if ($LASTEXITCODE -gt 1) { throw 'worker_git_policy_hook_configuration_unavailable' }
+  if (-not $original) { $original = Join-Path $gitDir 'hooks' }
+  elseif (-not [IO.Path]::IsPathRooted($original)) { $original = Join-Path $Repo $original }
+  # Never silently bypass an operator's publication policy.
+  if (Test-Path -LiteralPath (Join-Path $original 'pre-push')) { throw 'worker_git_policy_existing_pre_push: combine the operator hook before enabling this worker' }
+  $hookDir = Join-Path $Directory 'task-git-hooks'
+  [void][IO.Directory]::CreateDirectory($hookDir)
+  if (Test-Path -LiteralPath $original) {
+    foreach ($hook in @(Get-ChildItem -LiteralPath $original -File | Where-Object { $_.Name -notlike '*.sample' })) {
+      $proxy = "#!/bin/sh`nexec " + (ConvertTo-WorkerHookArgument ($hook.FullName -replace '\\','/')) + ' "$@"' + "`n"
+      [IO.File]::WriteAllText((Join-Path $hookDir $hook.Name), $proxy, (New-Object Text.UTF8Encoding($false)))
+    }
+  }
+  $dirty = @()
+  foreach ($gitArgs in @(@('diff','--name-only'), @('diff','--cached','--name-only'), @('ls-files','--others','--exclude-standard'))) {
+    $previousErrorAction = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+    try { $paths = @(& git -C $Repo -c core.quotepath=false @gitArgs 2>$null); $gitExit = $LASTEXITCODE }
+    finally { $ErrorActionPreference = $previousErrorAction }
+    if ($gitExit -ne 0) { throw 'worker_git_policy_dirty_baseline_unavailable' }
+    $dirty += $paths
+  }
+  $dirty = @($dirty | Sort-Object -Unique)
+  $policy = Join-Path $hookDir 'policy.json'
+  [IO.File]::WriteAllText($policy, (@{Repo=$Repo;TaskId=$TaskId;DirtyPaths=@($dirty)} | ConvertTo-Json -Depth 4 -Compress), (New-Object Text.UTF8Encoding($false)))
+  $guard = Join-Path $PSScriptRoot 'worker-pre-push.ps1'
+  $script = "#!/bin/sh`nexec powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File " + (ConvertTo-WorkerHookArgument ($guard -replace '\\','/')) + ' -Policy ' + (ConvertTo-WorkerHookArgument ($policy -replace '\\','/')) + "`n"
+  [IO.File]::WriteAllText((Join-Path $hookDir 'pre-push'), $script, (New-Object Text.UTF8Encoding($false)))
+  return $hookDir
+}
+
+function Set-WorkerGitPolicyEnvironment($Variables, [string]$HookDir) {
+  if (-not $HookDir) { return }
+  $count = 0
+  if ($Variables['GIT_CONFIG_COUNT'] -and -not [int]::TryParse($Variables['GIT_CONFIG_COUNT'], [ref]$count)) { throw 'worker_git_policy_invalid_environment' }
+  if ($count -lt 0 -or $count -gt 64) { throw 'worker_git_policy_invalid_environment' }
+  $Variables['GIT_CONFIG_COUNT'] = [string]($count + 1)
+  $Variables["GIT_CONFIG_KEY_$count"] = 'core.hooksPath'
+  $Variables["GIT_CONFIG_VALUE_$count"] = $HookDir -replace '\\','/'
+}
+
+function Get-WorkerTaskChanges([string]$Repo, [string]$Before, [string]$After, [string]$TaskId, [int]$DiffCap = 120000) {
+  $result = @{Commits=@();FileDiffs=@();n=0;totalIns=0;totalDel=0;files=@()}
+  if (-not $Before -or -not $After -or $Before -eq $After) { return $result }
+  if ($Before -notmatch '^[a-f0-9]{40}$' -or $After -notmatch '^[a-f0-9]{40}$' -or $TaskId -notmatch '^[a-fA-F0-9]{8}') { throw 'worker_task_diff_scope_invalid' }
+  $marker = '[' + $TaskId.Substring(0,8).ToLowerInvariant() + ']'
+  $candidates = @(& git -C $Repo log --reverse --format=%H "$Before..$After" 2>$null)
+  if ($LASTEXITCODE -ne 0) { throw 'worker_task_diff_history_unavailable' }
+  $files = @{}
+  foreach ($sha in $candidates) {
+    $message = (& git -C $Repo log -1 --format=%B $sha 2>$null | Out-String).ToLowerInvariant()
+    if ($LASTEXITCODE -ne 0) { throw 'worker_task_diff_commit_unavailable' }
+    if (-not $message.Contains($marker)) { continue }
+    $parents = ([string](& git -C $Repo rev-list --parents -n 1 $sha)).Split(' ')
+    if ($LASTEXITCODE -ne 0 -or $parents.Count -gt 2) { continue }
+    $result.Commits += [string]$sha
+    $stats = @(& git -C $Repo -c core.quotepath=false show --format= --numstat --no-renames $sha 2>$null)
+    if ($LASTEXITCODE -ne 0) { throw 'worker_task_diff_stat_unavailable' }
+    $types = @{}
+    foreach ($row in @(& git -C $Repo -c core.quotepath=false diff-tree --root --no-commit-id --name-status --no-renames -r $sha 2>$null)) {
+      $parts = ([string]$row) -split "`t",2
+      if ($parts.Count -eq 2) { $types[$parts[1]] = switch ($parts[0]) { 'A' {'added'} 'D' {'deleted'} default {'modified'} } }
+    }
+    foreach ($row in $stats) {
+      $parts = ([string]$row) -split "`t",3
+      if ($parts.Count -ne 3) { continue }
+      $name = $parts[2]; $binary = $parts[0] -eq '-'
+      $ins = 0; $del = 0
+      if (-not $binary) { $ins = [int]$parts[0]; $del = [int]$parts[1] }
+      if (-not $files.ContainsKey($name)) { $files[$name] = @{path=$name;change=$types[$name];additions=0;deletions=0;isBinary=$binary;unifiedDiff=$null;truncated=$false} }
+      $file = $files[$name]
+      $file.additions += $ins; $file.deletions += $del
+      if ($types[$name] -eq 'deleted') { $file.change = 'deleted' }
+      if (-not $binary) {
+        $patch = (& git -C $Repo show --format= --no-ext-diff --no-renames $sha -- $name 2>$null | Out-String)
+        if ($LASTEXITCODE -ne 0) { throw 'worker_task_diff_patch_unavailable' }
+        $combined = ([string]$file.unifiedDiff) + $patch
+        $file.unifiedDiff = $combined.Substring(0,[Math]::Min($DiffCap,$combined.Length))
+        $file.truncated = $file.truncated -or $combined.Length -gt $DiffCap
+      }
+    }
+  }
+  foreach ($name in @($files.Keys | Sort-Object)) {
+    $file = $files[$name]
+    $result.FileDiffs += $file
+    $result.files += @{name=$name;ins=$file.additions;del=$file.deletions}
+    $result.totalIns += $file.additions; $result.totalDel += $file.deletions
+  }
+  $result.n = $result.FileDiffs.Count
+  return $result
+}
diff --git a/worker-git-policy.tests.ps1 b/worker-git-policy.tests.ps1
new file mode 100644
index 0000000..05229c5
--- /dev/null
+++ b/worker-git-policy.tests.ps1
@@ -0,0 +1,112 @@
+﻿$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'worker-git-policy.ps1')
+$root = Join-Path ([IO.Path]::GetTempPath()) ('pf-git-policy-' + [guid]::NewGuid().ToString('N'))
+[void][IO.Directory]::CreateDirectory($root)
+$taskId = '12345678-1234-1234-1234-123456789abc'
+$script:checks = 0; $script:cases = 0
+function Check([bool]$ok, [string]$label) { if (-not $ok) { throw $label }; $script:checks++; Write-Host "PASS $label" }
+function Invoke-FixtureGit([string]$Repo, [string[]]$Arguments) {
+  $old = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+  try { $script:lastOutput = @(& git -C $Repo @Arguments 2>&1); return $LASTEXITCODE }
+  finally { $ErrorActionPreference = $old }
+}
+function Fixture {
+  $script:cases++
+  $path = Join-Path $root ([string]$script:cases)
+  $bare = Join-Path $root (([string]$script:cases) + '.git')
+  [void][IO.Directory]::CreateDirectory($path)
+  Check ((Invoke-FixtureGit $path @('init','-b','main')) -eq 0) 'fixture repository initialized'
+  $null = Invoke-FixtureGit $path @('config','user.name','Policy Test')
+  $null = Invoke-FixtureGit $path @('config','user.email','policy@example.test')
+  [IO.File]::WriteAllText((Join-Path $path 'operator.txt'),'original')
+  $null = Invoke-FixtureGit $path @('add','operator.txt'); $null = Invoke-FixtureGit $path @('commit','-m','base')
+  $null = Invoke-FixtureGit $root @('init','--bare',$bare)
+  $null = Invoke-FixtureGit $path @('remote','add','origin',$bare)
+  Check ((Invoke-FixtureGit $path @('push','-u','origin','main')) -eq 0) 'fixture baseline published'
+  return @{Repo=$path;Bare=$bare}
+}
+function Commit([string]$Repo, [string]$File, [string]$Message) {
+  [IO.File]::WriteAllText((Join-Path $Repo $File),[guid]::NewGuid().ToString())
+  $null = Invoke-FixtureGit $Repo @('add','--',$File)
+  Check ((Invoke-FixtureGit $Repo @('commit','-m',$Message)) -eq 0) 'fixture change committed'
+}
+function WithPolicy($Fixture, [scriptblock]$Action) {
+  $hook = New-WorkerGitPolicy $Fixture.Repo $taskId (Join-Path $root ('hooks-' + $script:cases))
+  $vars = @{}; Set-WorkerGitPolicyEnvironment $vars $hook
+  $saved = @{}
+  try {
+    foreach ($key in $vars.Keys) { $saved[$key] = [Environment]::GetEnvironmentVariable($key); [Environment]::SetEnvironmentVariable($key,$vars[$key]) }
+    & $Action $Fixture
+  } finally { foreach ($key in $saved.Keys) { [Environment]::SetEnvironmentVariable($key,$saved[$key]) } }
+}
+try {
+  $ast = [Management.Automation.Language.Parser]::ParseFile((Join-Path $PSScriptRoot 'workspace-guard.ps1'),[ref]$null,[ref]$null)
+  $function = $ast.Find({param($node) $node -is [Management.Automation.Language.FunctionDefinitionAst] -and $node.Name -eq 'Test-CommandBoundary'},$true)
+  . ([scriptblock]::Create($function.Extent.Text))
+  foreach ($command in @('git push --force origin HEAD','git -c credential.helper= push origin HEAD --no-verify','git -c core.hooksPath=disabled push origin HEAD','$env:GIT_CONFIG_COUNT = 0; git push origin HEAD','git reset --hard','git checkout --ours file.ts')) {
+    Check ([bool](Test-CommandBoundary $command)) ('workspace guard rejects unsafe git recovery or policy bypass: ' + $command)
+  }
+  Check (-not (Test-CommandBoundary 'git push origin HEAD')) 'workspace guard preserves a normal task push'
+  $f = Fixture
+  $lease = Enter-WorkerCheckoutLease $f.Repo
+  $busy = $false; try { $other = Enter-WorkerCheckoutLease $f.Repo; $other.Dispose() } catch { $busy = $_.Exception.Message -match 'worker_checkout_busy' }
+  Check $busy 'another task or dispatcher cannot acquire the same checkout'
+  $lease.Dispose(); $lease = Enter-WorkerCheckoutLease $f.Repo; $lease.Dispose()
+  Check $true 'checkout lease is released after worker exit'
+  [IO.File]::WriteAllText((Join-Path $f.Repo 'operator.txt'),'operator work, preserve it')
+  WithPolicy $f {
+    param($f)
+    Commit $f.Repo 'own.txt' 'fix: own change [12345678]'
+    Check ((Invoke-FixtureGit $f.Repo @('push','origin','HEAD:main')) -eq 0) ('valid task push accepted: ' + ($script:lastOutput -join ' '))
+    Check ([IO.File]::ReadAllText((Join-Path $f.Repo 'operator.txt')) -eq 'operator work, preserve it') 'unrelated dirty file is preserved'
+  }
+  $null = Invoke-FixtureGit $f.Repo @('config','--local','--get','core.hooksPath')
+  Check ($script:lastOutput.Count -eq 0) 'worker policy does not change persistent git configuration'
+
+  $f = Fixture
+  WithPolicy $f {
+    param($f)
+    Commit $f.Repo 'foreign.txt' 'fix: another task [abcdef12]'
+    Check ((Invoke-FixtureGit $f.Repo @('push','origin','HEAD:main')) -ne 0) 'foreign outgoing commit is rejected'
+    Check (($script:lastOutput -join ' ') -match 'foreign_commit_in_push') 'foreign commit rejection is explained'
+  }
+  $before = ([string](& git -C $f.Repo rev-parse HEAD~1)).Trim()
+  Commit $f.Repo 'own.txt' 'fix: this task [12345678]'
+  $after = ([string](& git -C $f.Repo rev-parse HEAD)).Trim()
+  $changes = Get-WorkerTaskChanges $f.Repo $before $after $taskId
+  Check ($changes.Commits.Count -eq 1 -and $changes.Commits[0] -eq $after) 'auto-link selects only the current task commit'
+  Check ($changes.n -eq 1 -and $changes.FileDiffs[0].path -eq 'own.txt') 'LIVE excludes files from fetched or other task commits'
+  Check ($changes.totalIns -eq 1 -and $changes.totalDel -eq 0) 'report statistics describe only task changes'
+
+  $f = Fixture
+  [IO.File]::WriteAllText((Join-Path $f.Repo 'operator.txt'),'preexisting work')
+  WithPolicy $f {
+    param($f)
+    Commit $f.Repo 'operator.txt' 'fix: accidentally staged operator file [12345678]'
+    Check ((Invoke-FixtureGit $f.Repo @('push','origin','HEAD:main')) -ne 0) 'task marker cannot authorize publishing preexisting operator changes'
+    Check (($script:lastOutput -join ' ') -match 'preexisting_changes_in_commit') 'dirty baseline rejection is explained'
+  }
+
+  $f = Fixture
+  $base = ([string](& git -C $f.Repo rev-parse HEAD)).Trim()
+  Commit $f.Repo 'published.txt' 'published work [abcdef12]'
+  $null = Invoke-FixtureGit $f.Repo @('push','origin','HEAD:main')
+  # This is a disposable fixture, verified inside the task's temporary root.
+  if (-not ([IO.Path]::GetFullPath($f.Repo)).StartsWith($root + [IO.Path]::DirectorySeparatorChar)) { throw 'unsafe_fixture_path' }
+  $null = Invoke-FixtureGit $f.Repo @('reset','--hard',$base)
+  WithPolicy $f {
+    param($f)
+    Commit $f.Repo 'rewrite.txt' 'fix: attempted rewrite [12345678]'
+    Check ((Invoke-FixtureGit $f.Repo @('push','--force','origin','HEAD:main')) -ne 0) 'force flag cannot overwrite newer published history'
+    Check (($script:lastOutput -join ' ') -match 'remote_history_changed') 'published history rejection is explained'
+  }
+
+  $f = Fixture
+  [IO.File]::WriteAllText((Join-Path $f.Repo '.git/hooks/pre-push'),"#!/bin/sh`nexit 0`n")
+  $rejected = $false; try { $null = New-WorkerGitPolicy $f.Repo $taskId (Join-Path $root 'existing-hook') } catch { $rejected = $_.Exception.Message -match 'existing_pre_push' }
+  Check $rejected 'existing operator publication hooks are never bypassed'
+} finally {
+  $resolved = [IO.Path]::GetFullPath($root)
+  if ($resolved.StartsWith([IO.Path]::GetFullPath([IO.Path]::GetTempPath())) -and [IO.Path]::GetFileName($resolved).StartsWith('pf-git-policy-')) { Remove-Item -LiteralPath $resolved -Recurse -Force }
+}
+Write-Host "$script:checks checks passed"
diff --git a/worker-pre-push.ps1 b/worker-pre-push.ps1
new file mode 100644
index 0000000..cc8259d
--- /dev/null
+++ b/worker-pre-push.ps1
@@ -0,0 +1,36 @@
+﻿param([Parameter(Mandatory=$true)][string]$Policy)
+$ErrorActionPreference = 'Stop'
+try {
+  [Console]::OutputEncoding = [Text.Encoding]::UTF8
+  $p = [IO.File]::ReadAllText($Policy, [Text.Encoding]::UTF8) | ConvertFrom-Json
+  $repo = [string]$p.Repo
+  $marker = '[' + ([string]$p.TaskId).Substring(0,8).ToLowerInvariant() + ']'
+  while ($line = [Console]::In.ReadLine()) {
+    $parts = $line -split ' '
+    if ($parts.Count -ne 4) { throw 'invalid_push_input' }
+    $localRef, $local, $remoteRef, $remote = $parts
+    if ($local -match '^0+$') { throw 'branch_deletion_forbidden' }
+    if ($local -notmatch '^[a-f0-9]{40}$' -or $remote -notmatch '^[a-f0-9]{40}$' -or $remoteRef -notlike 'refs/heads/*') { throw 'only_task_branch_push_allowed' }
+    if ($remote -notmatch '^0+$') {
+      & git -C $repo merge-base --is-ancestor $remote $local 2>$null
+      if ($LASTEXITCODE -ne 0) { throw 'remote_history_changed: fetch and integrate current main; force-push is forbidden' }
+      $commits = @(& git -C $repo rev-list "$remote..$local" 2>$null)
+    } else { $commits = @(& git -C $repo rev-list $local --not --remotes 2>$null) }
+    if ($LASTEXITCODE -ne 0) { throw 'cannot_verify_outgoing_commits' }
+    foreach ($sha in $commits) {
+      $message = (& git -C $repo log -1 --format=%B $sha 2>$null | Out-String).ToLowerInvariant()
+      if ($LASTEXITCODE -ne 0 -or -not $message.Contains($marker)) { throw 'foreign_commit_in_push: publish only commits marked for this task' }
+      $parents = ([string](& git -C $repo rev-list --parents -n 1 $sha)).Split(' ')
+      if ($LASTEXITCODE -ne 0 -or $parents.Count -gt 2) { throw 'merge_commit_requires_review' }
+      $files = @(& git -C $repo -c core.quotepath=false diff-tree --root --no-commit-id --name-only -r $sha 2>$null)
+      if ($LASTEXITCODE -ne 0) { throw 'cannot_verify_commit_files' }
+      foreach ($file in $files) {
+        if (@($p.DirtyPaths) -contains $file) { throw 'preexisting_changes_in_commit: preserve operator files; request review before publishing them' }
+      }
+    }
+  }
+  exit 0
+} catch {
+  [Console]::Error.WriteLine('ProjectsFlow: push blocked: ' + $_.Exception.Message)
+  exit 1
+}
