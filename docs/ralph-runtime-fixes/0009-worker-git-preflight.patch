diff --git a/worker-git-preflight.ps1 b/worker-git-preflight.ps1
new file mode 100644
--- /dev/null
+++ b/worker-git-preflight.ps1
@@ -0,0 +1,156 @@
+﻿# Native Git gate: fetch remote refs, never change HEAD, the index or working files.
+function ConvertTo-WorkerGitArgument([string]$Value) {
+  if ($Value -notmatch '[\s"]' -and $Value.Length) { return $Value }
+  return '"' + ([regex]::Replace(([regex]::Replace($Value, '(\\*)"', '$1$1\"')), '(\\+)$', '$1$1')) + '"'
+}
+
+function Invoke-WorkerSyncGit([string]$Repo, [string[]]$Arguments, [int]$TimeoutMs = 60000) {
+  $info = New-Object Diagnostics.ProcessStartInfo
+  $info.FileName = 'git.exe'
+  $info.Arguments = (@('-C', $Repo) + $Arguments | ForEach-Object { ConvertTo-WorkerGitArgument ([string]$_) }) -join ' '
+  $info.UseShellExecute = $false; $info.CreateNoWindow = $true
+  $info.RedirectStandardOutput = $true; $info.RedirectStandardError = $true; $info.RedirectStandardInput = $true
+  $info.EnvironmentVariables['GIT_TERMINAL_PROMPT'] = '0'
+  $info.EnvironmentVariables['GCM_INTERACTIVE'] = 'never'
+  $process = [Diagnostics.Process]::Start($info)
+  try {
+    $process.StandardInput.Close()
+    $stdout = $process.StandardOutput.ReadToEndAsync(); $stderr = $process.StandardError.ReadToEndAsync()
+    if (-not $process.WaitForExit($TimeoutMs)) {
+      & taskkill /PID $process.Id /T /F 2>$null | Out-Null
+      throw 'worker_git_sync_timeout: Git did not complete; worker is blocked without changing local files'
+    }
+    $output = $stdout.Result; $detail = $stderr.Result
+    $detail = $detail -replace '(?i)(https?://)[^\s/@]+@', '$1[redacted]@'
+    $detail = $detail -replace '(?i)(?:gh[pousr]_|github_pat_)[a-z0-9_]+', '[redacted]'
+    return @{ Code = $process.ExitCode; Output = $output.Trim(); Detail = $detail.Substring(0, [Math]::Min(1500, $detail.Length)).Trim() }
+  } finally { $process.Dispose() }
+}
+
+function Read-WorkerSyncGit([string]$Repo, [string[]]$Arguments) {
+  $result = Invoke-WorkerSyncGit $Repo $Arguments
+  if ($result.Code -ne 0) { throw ('worker_git_sync_read_failed: ' + ($Arguments -join ' ') + ': ' + $result.Detail) }
+  return [string]$result.Output
+}
+
+function Get-WorkerSyncRemote([string]$Repo) {
+  $remotes = @((Read-WorkerSyncGit $Repo @('remote')) -split '\r?\n' | Where-Object { $_ })
+  if (-not $remotes.Count) { return '' }
+  $github = @{}
+  $githubPattern = '(?i)^(?:https://(?:[^/@\s]+@)?github\.com/|git@github\.com:|ssh://(?:git@)?github\.com(?::(?:22|443))?/)([^/\s]+/[^/\s]+?)(?:\.git)?/?$'
+  foreach ($remote in $remotes) {
+    if ($remote -notmatch '^[a-zA-Z0-9][a-zA-Z0-9._/-]*$') { throw 'worker_git_sync_invalid_remote_name' }
+    $urls = @((Read-WorkerSyncGit $Repo @('remote', 'get-url', '--all', $remote)) -split '\r?\n')
+    $identities = @($urls | ForEach-Object {
+      if ($_ -match $githubPattern) {
+        $Matches[1].ToLowerInvariant()
+      }
+    } | Sort-Object -Unique)
+    if ($identities.Count) {
+      if ($identities.Count -ne 1 -or $urls.Count -ne @($urls | Where-Object { $_ -match $githubPattern }).Count) {
+        throw 'worker_git_sync_ambiguous_remote: one remote points at different repositories'
+      }
+      $github[$remote] = $identities[0]
+    }
+  }
+  if (@($github.Values | Sort-Object -Unique).Count -gt 1) { throw 'worker_git_sync_ambiguous_github: cannot choose between different GitHub repositories' }
+  $branch = Invoke-WorkerSyncGit $Repo @('symbolic-ref', '--quiet', '--short', 'HEAD')
+  $upstream = if ($branch.Code -eq 0) { Invoke-WorkerSyncGit $Repo @('config', '--get', ('branch.' + $branch.Output + '.remote')) } else { $null }
+  if ($github.Count) {
+    if ($upstream -and $github.ContainsKey($upstream.Output)) { return [string]$upstream.Output }
+    if ($github.ContainsKey('github')) { return 'github' }
+    if ($github.ContainsKey('origin')) { return 'origin' }
+    return [string]@($github.Keys | Sort-Object)[0]
+  }
+  if ($upstream -and $upstream.Output -ne '.' -and $remotes -contains $upstream.Output) { return [string]$upstream.Output }
+  if ($remotes -contains 'origin') { return 'origin' }
+  if ($remotes.Count -eq 1) { return [string]$remotes[0] }
+  throw 'worker_git_sync_ambiguous_remote: no unambiguous upstream'
+}
+
+function Assert-WorkerGitSynchronized([string]$Repo) {
+  if (-not $Repo -or -not (Test-Path -LiteralPath (Join-Path $Repo '.git'))) { return }
+  $remote = Get-WorkerSyncRemote $Repo
+  if (-not $remote) { return }
+  $branch = Read-WorkerSyncGit $Repo @('symbolic-ref', '--quiet', '--short', 'HEAD')
+  $fetch = Invoke-WorkerSyncGit $Repo @('-c', 'credential.interactive=false', 'fetch', '--prune', '--no-tags', $remote, ('+refs/heads/*:refs/remotes/' + $remote + '/*'))
+  if ($fetch.Code -ne 0) { throw ('worker_git_sync_fetch_failed: ' + $remote + ': ' + $fetch.Detail) }
+  $remoteHead = Invoke-WorkerSyncGit $Repo @('ls-remote', '--symref', $remote, 'HEAD')
+  if ($remoteHead.Code -ne 0) { throw ('worker_git_sync_remote_head_failed: ' + $remoteHead.Detail) }
+  $primary = ''; $advertised = ''
+  foreach ($line in ($remoteHead.Output -split '\r?\n')) {
+    if ($line -match '^ref:\s+refs/heads/(.+)\s+HEAD$') { $primary = $Matches[1] }
+    if ($line -match '^([a-f0-9]{40}|[a-f0-9]{64})\s+HEAD$') { $advertised = $Matches[1] }
+  }
+  if (-not $primary -or -not $advertised) {
+    $heads = Read-WorkerSyncGit $Repo @('ls-remote', '--heads', $remote)
+    if (-not $heads) { return } # An empty remote permits the first task commit.
+    throw 'worker_git_sync_default_branch_unknown: remote HEAD must identify its real primary branch'
+  }
+  $primaryRef = 'refs/remotes/' + $remote + '/' + $primary
+  $fetched = Read-WorkerSyncGit $Repo @('rev-parse', '--verify', $primaryRef)
+  if ($fetched -ne $advertised) { throw 'worker_git_sync_remote_changed_during_fetch: retry synchronization' }
+  $refs = @($primaryRef)
+  $branchRef = 'refs/remotes/' + $remote + '/' + $branch
+  $hasBranch = Invoke-WorkerSyncGit $Repo @('show-ref', '--verify', '--quiet', $branchRef)
+  if ($hasBranch.Code -eq 0) { $refs += $branchRef }
+  elseif ($hasBranch.Code -ne 1) { throw 'worker_git_sync_branch_read_failed' }
+  $upstreamRemote = Invoke-WorkerSyncGit $Repo @('config', '--get', ('branch.' + $branch + '.remote'))
+  if ($upstreamRemote.Code -eq 0 -and $upstreamRemote.Output -eq $remote) {
+    $merge = Read-WorkerSyncGit $Repo @('config', '--get', ('branch.' + $branch + '.merge'))
+    if ($merge -notlike 'refs/heads/*') { throw 'worker_git_sync_invalid_upstream' }
+    $tracked = 'refs/remotes/' + $remote + '/' + $merge.Substring(11)
+    $trackedExists = Invoke-WorkerSyncGit $Repo @('show-ref', '--verify', '--quiet', $tracked)
+    if ($trackedExists.Code -ne 0) { throw 'worker_git_sync_upstream_deleted: do not recreate an upstream branch without review' }
+    $refs += $tracked
+  }
+  foreach ($ref in @($refs | Sort-Object -Unique)) {
+    $ancestor = Invoke-WorkerSyncGit $Repo @('merge-base', '--is-ancestor', $ref, 'HEAD')
+    if ($ancestor.Code -eq 1) { throw ('worker_git_sync_integration_required: ' + $ref + ' is not included in HEAD; preserve local changes and integrate in a separate safe checkout before retrying') }
+    if ($ancestor.Code -ne 0) { throw ('worker_git_sync_history_unavailable: ' + $ancestor.Detail) }
+  }
+}
+
+function Get-WorkerRunGitDirectory($Run) {
+  if ($Run.TextOnly) { return '' }
+  if ($Run.SessionWorkDir) { return [string]$Run.SessionWorkDir }
+  $arguments = @($Run.Args)
+  for ($index = 0; $index -lt ($arguments.Count - 1); $index++) {
+    if ($arguments[$index] -eq '-C') { return [string]$arguments[$index + 1] }
+  }
+  throw 'worker_git_sync_workspace_missing: cannot verify a tool-enabled worker'
+}
+
+# Wrap existing hooks instead of changing persistent Git config or bypassing operator hooks.
+function Add-WorkerGitSyncHooks([string]$Repo, [string]$Directory, [string]$HookDir = '') {
+  if (-not $Repo -or -not (Test-Path -LiteralPath (Join-Path $Repo '.git'))) { return '' }
+  if (-not $HookDir) {
+    $HookDir = Join-Path $Directory 'sync-git-hooks'
+    [void][IO.Directory]::CreateDirectory($HookDir)
+    $gitDir = Read-WorkerSyncGit $Repo @('rev-parse', '--absolute-git-dir')
+    $configured = Invoke-WorkerSyncGit $Repo @('config', '--get', 'core.hooksPath')
+    if ($configured.Code -gt 1) { throw 'worker_git_sync_hook_configuration_unavailable' }
+    $original = if ($configured.Output) { $configured.Output } else { Join-Path $gitDir 'hooks' }
+    if (-not [IO.Path]::IsPathRooted($original)) { $original = Join-Path $Repo $original }
+    if (Test-Path -LiteralPath $original) {
+      foreach ($hook in @(Get-ChildItem -LiteralPath $original -File | Where-Object { $_.Name -notlike '*.sample' })) {
+        $proxy = "#!/bin/sh`nexec " + (ConvertTo-WorkerHookArgument ($hook.FullName -replace '\\', '/')) + ' "$@"' + "`n"
+        [IO.File]::WriteAllText((Join-Path $HookDir $hook.Name), $proxy, (New-Object Text.UTF8Encoding($false)))
+      }
+    }
+  }
+  foreach ($name in @('pre-commit', 'pre-push')) {
+    $path = Join-Path $HookDir $name
+    $tail = "exit 0`n"
+    if (Test-Path -LiteralPath $path) {
+      $chained = $path + '.after-sync'
+      Copy-Item -LiteralPath $path -Destination $chained
+      $tail = 'exec ' + (ConvertTo-WorkerHookArgument ($chained -replace '\\', '/')) + ' "$@"' + "`n"
+    }
+    $command = 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' +
+      (ConvertTo-WorkerHookArgument ((Join-Path $PSScriptRoot 'worker-git-sync-hook.ps1') -replace '\\', '/')) +
+      ' -Repo ' + (ConvertTo-WorkerHookArgument ($Repo -replace '\\', '/'))
+    [IO.File]::WriteAllText($path, ("#!/bin/sh`n" + $command + " || exit `$?`n" + $tail), (New-Object Text.UTF8Encoding($false)))
+  }
+  return $HookDir
+}
