---
// Шрифт — системный стек Notion (--font-sans в tokens.css), веб-шрифты не грузим.
import '@/styles/globals.css';
// Общие классы секций лендинга (контейнер, кнопки, карточки, метки).
import '@/styles/landing.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE = 'https://projectsflow.ru/';
const {
  title = 'ProjectsFlow — опиши идею, получи готовый продукт',
  description =
    'Платформа для тех, кто строит с AI: ты описываешь идею — она доводит проект до готового ' +
    'результата сама. Без настройки и технической возни. Прозрачные расходы, старт бесплатно.',
} = Astro.props;
const ogImage = new URL('/og.png', SITE).href;
// Канонический URL/og:url — по текущему пути (иначе статьи блога самоканонятся в корень).
const canonical = new URL(Astro.url.pathname, SITE).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171b" media="(prefers-color-scheme: dark)" />
    <!-- Тёмная тема — по системной настройке: браузер сразу красит холст нужным цветом. -->
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ProjectsFlow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ProjectsFlow — опиши идею, получи готовый продукт" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">К содержимому</a>
    <slot />

    {/* ===== Чат-виджет помощи (P2) =====================================
        Остров создаёт P2 (HelpWidget*). Когда он появится в main — раскомментировать
        строку ниже (один импорт + монтаж снизу справа), island грузится отложенно.
        До готовности P2 — плейсхолдер, не блокируемся (см. план §3, §H п.12).
        TODO(P2): <HelpWidget client:idle /> + import в frontmatter. */}

    <script>
      // Auth-aware UI: чекаем /api/auth/me. 200 → выставляем html[data-auth="authed"],
      // CSS в landing.css переключает видимость [data-auth-anon]/[data-auth-authed].
      // На 401/ошибке ничего не делаем — дефолт уже anonymous.
      (async () => {
        try {
          const res = await fetch('/api/auth/me', { credentials: 'include' });
          if (!res.ok) return;
          document.documentElement.dataset.auth = 'authed';
        } catch {
          // Сеть недоступна или эндпоинт не отвечает — оставляем anonymous-дефолты.
        }
      })();
    </script>
  </body>
</html>
