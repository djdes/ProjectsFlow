---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import Features from '@/components/Features.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Pricing from '@/components/Pricing.astro';
import Guarantees from '@/components/Guarantees.astro';
import Faq from '@/components/Faq.astro';
import BlogTeaser from '@/components/BlogTeaser.astro';
import CTASection from '@/components/CTASection.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout>
  <Nav />
  <main id="main">
    <!-- Порядок: фраза и живая доска → путь задачи (табло) → возможности во вкладках с окнами
         приложения (Screenshots внутри Features) → тарифы и гарантии на одной полосе →
         вопросы → блог → что поручить и старт. Бумага меняется полосами, а не карточками. -->
    <Hero />
    <HowItWorks />
    <Features />
    <Pricing />
    <Guarantees />
    <Faq />
    <BlogTeaser />
    <CTASection />
  </main>
  <Footer />
  <!-- Окна во вкладках — образцы в слотах: hallmarkSlots({ 'feat-idea': '/shots/…png' })
       подменит образец настоящим скриншотом. -->
  <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelectorAll(':scope > img').forEach((o) => o.remove()); s.prepend(im); } };
document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
</BaseLayout>
