---
// Главная: чёрная система (landing/DESIGN.md, стили styles/home.css, движение scripts/home-motion.ts).
// Статичные Astro-компоненты без гидрации; тексты — data/home.ts, тарифы — pricing.ts, вопросы — faq.ts.
import '@fontsource-variable/inter/opsz.css';
import '@/styles/home.css';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeDetails from '@/components/home/HomeDetails.astro';
import HomeFaq from '@/components/home/HomeFaq.astro';
import HomeFeatures from '@/components/home/HomeFeatures.astro';
import HomeFinal from '@/components/home/HomeFinal.astro';
import HomeFooter from '@/components/home/HomeFooter.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeNav from '@/components/home/HomeNav.astro';
import HomePlatforms from '@/components/home/HomePlatforms.astro';
import HomePricing from '@/components/home/HomePricing.astro';
import HomeStatement from '@/components/home/HomeStatement.astro';
import HomeSteps from '@/components/home/HomeSteps.astro';
import { PLANS } from '@/data/pricing';
import { FAQ } from '@/data/faq';
import { SITE_DESCRIPTION } from '@/data/site';

const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((p) => ({ slug: p.id, title: p.data.title }));

const SITE = 'https://projectsflow.ru';

// Структурированные данные для поиска: бренд, сайт, продукт с ценами тарифов и FAQ.
// Цены и вопросы берутся из тех же data-файлов, что и видимая страница — расхождений не будет.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ProjectsFlow',
    url: SITE,
    logo: `${SITE}/favicon.svg`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ProjectsFlow',
    url: SITE,
    inLanguage: 'ru-RU',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'ProjectsFlow',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: SITE,
    inLanguage: 'ru-RU',
    description: SITE_DESCRIPTION,
    offers: PLANS.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: String(p.priceRub),
      priceCurrency: 'RUB',
      url: `${SITE}${p.href}`,
      availability: 'https://schema.org/InStock',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout jsonLd={jsonLd} themeColor="#000000">
  <div class="pf">
    <HomeNav appBase={appBase} />
    <main id="main">
      <div class="intro">
        <HomeHero appBase={appBase} />
        <HomeStatement />
      </div>
      <HomeFeatures />
      <HomeSteps appBase={appBase} />
      <HomeDetails />
      <HomePlatforms />
      <HomePricing appBase={appBase} />
      <HomeFaq />
      <HomeFinal appBase={appBase} />
    </main>
    <HomeFooter appBase={appBase} posts={posts} />
  </div>
</BaseLayout>

<script>
  import { initHomeMotion } from '@/scripts/home-motion';

  const root = document.querySelector('.pf');
  if (root instanceof HTMLElement) initHomeMotion(root);
</script>
