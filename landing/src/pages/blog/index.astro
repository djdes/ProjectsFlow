---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import PostCard from '@/components/PostCard.astro';
import { readingMinutes, topicTone } from '@/lib/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const cards = posts.map((post) => ({
  slug: post.id,
  minutes: readingMinutes(post.body ?? ''),
  ...post.data,
}));

// Темы для фильтра (в порядке появления) со счётчиком статей.
const topics = Array.from(new Set(cards.map((c) => c.topic))).map((t) => ({
  name: t,
  count: cards.filter((c) => c.topic === t).length,
}));
---

<BaseLayout
  title="Блог ProjectsFlow — как строить продукты с AI"
  description="Практика, продукт, деньги и автоматизация для тех, кто строит с AI. Короткие полезные статьи от команды ProjectsFlow."
>
  <Nav />
  <main id="main" class="blog">
    <div class="pf-container">
      <header class="blog__head">
        <h1 class="blog__title">Как строить продукты с&nbsp;AI</h1>
        <p class="pf-lead">
          Короткие полезные заметки о практике, продукте, деньгах и автоматизации.
          Без воды — то, что пригодится, когда строишь своё.
        </p>
      </header>

      <div class="blog__filters" role="group" aria-label="Фильтр по темам">
        <button type="button" class="chip" data-topic-filter="Все" aria-pressed="true">
          Все <span class="chip__count">{cards.length}</span>
        </button>
        {
          topics.map((t) => (
            <button type="button" class={`chip ${topicTone(t.name)}`} data-topic-filter={t.name} aria-pressed="false">
              <span class="chip__dot" aria-hidden="true" />
              {t.name} <span class="chip__count">{t.count}</span>
            </button>
          ))
        }
      </div>

      <ul class="blog__grid">
        {
          cards.map((c) => (
            <li class="blog__item" data-topic={c.topic}>
              <PostCard
                slug={c.slug}
                title={c.title}
                topic={c.topic}
                date={c.date}
                minutes={c.minutes}
                description={c.description}
                level={2}
              />
            </li>
          ))
        }
      </ul>

      <p class="blog__empty" data-blog-empty hidden>По этой теме пока нет статей.</p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) var(--section-y);
  }
  .blog__head {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-inline-size: 46rem;
    margin-block-end: 2rem;
  }
  .blog__title {
    font-size: clamp(2.25rem, 1.75rem + 2vw, 3rem);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: oklch(var(--foreground));
  }

  /* Чипы-фильтры: 28px, рамка, точка тона темы, счётчик серым; выбранный — синяя подложка. */
  .blog__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-block-end: 1.75rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 1.75rem;
    padding-inline: 0.625rem;
    border: 1px solid oklch(var(--border));
    border-radius: var(--r-md);
    background: transparent;
    color: oklch(var(--foreground));
    font: inherit;
    font-size: var(--text-ui);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .chip__dot {
    flex: none;
    inline-size: 0.4375rem;
    block-size: 0.4375rem;
    border-radius: 2px;
    background: var(--tone);
  }
  .chip__count {
    color: oklch(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }
  .chip[aria-pressed='true'] {
    border-color: oklch(var(--primary));
    background: var(--primary-soft);
  }
  /* Серый счётчик на мягкой синей подложке не дотягивает до AA — берём синий текст (4.7:1). */
  .chip[aria-pressed='true'] .chip__count { color: oklch(var(--primary-ink)); }
  .chip:active { background: var(--active); }
  @media (hover: hover) and (pointer: fine) {
    .chip:hover { background: var(--hover); }
    .chip[aria-pressed='true']:hover { background: var(--primary-soft); }
  }
  @media (pointer: coarse) {
    .chip { min-block-size: 2.5rem; }
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .blog__item[hidden] { display: none; }
  .blog__empty {
    margin-block-start: 2rem;
    color: oklch(var(--muted-foreground));
  }
</style>

<script>
  // Фильтр по темам: переключает видимость карточек по data-topic.
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic-filter]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.blog__item'));
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');

  const apply = (topic: string): void => {
    let shown = 0;
    for (const el of items) {
      const match = topic === 'Все' || el.dataset.topic === topic;
      el.hidden = !match;
      if (match) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  };

  for (const btn of filters) {
    btn.addEventListener('click', () => {
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      apply(btn.dataset.topicFilter ?? 'Все');
    });
  }
</script>
