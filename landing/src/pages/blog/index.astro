---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import PostCard from '@/components/PostCard.astro';
import { readingMinutes } from '@/lib/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const cards = posts.map((post) => ({
  slug: post.id,
  minutes: readingMinutes(post.body ?? ''),
  ...post.data,
}));

// Темы для фильтра (в порядке появления) со счётчиком статей.
const topics = Array.from(new Set(cards.map((c) => c.topic))).map((t) => ({
  name: t,
  count: cards.filter((c) => c.topic === t).length,
}));
---

<BaseLayout
  title="Блог ProjectsFlow — как строить продукты с AI"
  description="Практика, продукт, деньги и автоматизация для тех, кто строит с AI. Короткие полезные статьи от команды ProjectsFlow."
>
  <Nav />
  <main id="main" class="blog">
    <div class="pf-container">
      <header class="blog__head">
        <h1 class="blog__title">Как строить продукты с&nbsp;AI</h1>
        <p class="pf-lead">
          Короткие полезные заметки о практике, продукте, деньгах и автоматизации.
          Без воды: то, что пригодится, когда строишь своё.
        </p>
      </header>

      <div class="blog__filters" role="group" aria-label="Фильтр по темам">
        <button type="button" class="chip" data-topic-filter="Все" aria-pressed="true">
          Все <span class="chip__count">{cards.length}</span>
        </button>
        {
          topics.map((t) => (
            <button type="button" class="chip" data-topic-filter={t.name} aria-pressed="false">
              {t.name} <span class="chip__count">{t.count}</span>
            </button>
          ))
        }
      </div>

      <ul class="blog__grid">
        {
          cards.map((c) => (
            <li class="blog__item" data-topic={c.topic}>
              <PostCard
                slug={c.slug}
                title={c.title}
                topic={c.topic}
                date={c.date}
                minutes={c.minutes}
                description={c.description}
                level={2}
              />
            </li>
          ))
        }
      </ul>

      <p class="blog__empty" data-blog-empty hidden>По этой теме пока нет статей.</p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog {
    padding-block: var(--space-2xl) var(--section-gap-s);
  }
  .blog__head {
    display: grid;
    gap: var(--space-md);
    margin-block-end: var(--space-xl);
    padding-block-end: var(--space-lg);
    border-block-end: var(--rule-bar) solid var(--color-ink);
  }
  .blog__title {
    max-inline-size: none;
    font-size: var(--text-display-s);
  }

  /* Фильтр тем — квадратные клетки на общих рамках 2px; выбранная — чернилами. */
  .blog__filters {
    display: flex;
    flex-wrap: wrap;
    margin-block-end: var(--space-xl);
    padding-inline-start: var(--rule-bar);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: 44px;
    margin-inline-start: calc(-1 * var(--rule-bar));
    padding-inline: var(--space-md);
    border: var(--rule-bar) solid var(--color-ink);
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 800;
    cursor: pointer;
    transition: background-color var(--dur-micro) steps(1), color var(--dur-micro) steps(1);
  }
  .chip__count {
    font-weight: 500;
    color: var(--color-muted);
  }
  .chip[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .chip[aria-pressed='true'] .chip__count { color: var(--color-paper-2); }
  .chip:focus-visible { position: relative; z-index: var(--z-raised); outline-offset: 3px; }
  .chip:active { transform: translateY(1px); }
  @media (hover: hover) and (pointer: fine) {
    .chip[aria-pressed='false']:hover { background: var(--color-paper-2); }
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--gap-columns);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .blog__item[hidden] { display: none; }
  .blog__empty {
    margin-block-start: var(--space-xl);
    color: var(--color-muted);
  }
</style>

<script>
  // Фильтр по темам: переключает видимость карточек по data-topic.
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic-filter]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.blog__item'));
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');

  const apply = (topic: string): void => {
    let shown = 0;
    for (const el of items) {
      const match = topic === 'Все' || el.dataset.topic === topic;
      el.hidden = !match;
      if (match) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  };

  for (const btn of filters) {
    btn.addEventListener('click', () => {
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      apply(btn.dataset.topicFilter ?? 'Все');
    });
  }
</script>
