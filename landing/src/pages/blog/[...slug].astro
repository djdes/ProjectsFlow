---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import PostCard from '@/components/PostCard.astro';
import { readingMinutes, formatDate } from '@/lib/blog';
import { nbspDash } from '@/lib/typo';

// Лендинг и SPA — один Express в prod; в dev можно указать PUBLIC_APP_URL.
const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const minutes = readingMinutes(post.body ?? '');
// Оглавление: h2 как разделы, h3 — вложенные подпункты.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// «Читайте также»: сначала статьи той же темы, потом остальные — 3 штуки (перелинковка + SEO).
const all = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const related = [
  ...all.filter((p) => p.data.topic === post.data.topic),
  ...all.filter((p) => p.data.topic !== post.data.topic),
]
  .slice(0, 3)
  .map((p) => ({ slug: p.id, minutes: readingMinutes(p.body ?? ''), ...p.data }));

// Разметка для поисковиков (rich results).
const canonical = `https://projectsflow.ru/blog/${post.id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: 'ProjectsFlow',
    url: 'https://projectsflow.ru',
    logo: { '@type': 'ImageObject', url: 'https://projectsflow.ru/og.png' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: 'https://projectsflow.ru/og.png',
  inLanguage: 'ru-RU',
};
---

<BaseLayout title={`${post.data.title} — Блог ProjectsFlow`} description={post.data.description}>
  <!-- Прогресс чтения: тонкая полоса сверху, заполняется по мере прокрутки статьи. -->
  <div class="read-progress" aria-hidden="true"><span data-read-bar></span></div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <Nav />
  <main id="main" class="post">
    <div class="pf-container">
      <nav class="post__crumbs" aria-label="Хлебные крошки">
        <a href="/blog" class="post__crumb">Блог</a>
        <svg class="post__sep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="post__crumb post__crumb--current" aria-current="page">{post.data.topic}</span>
      </nav>

      <header class="post__head">
        <span class="pf-pill post__topic">{post.data.topic}</span>
        <h1 class="post__title">{nbspDash(post.data.title)}</h1>
        <p class="post__desc">{post.data.description}</p>
        <p class="post__meta">
          <span class="post__meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {post.data.author}
          </span>
          <span class="post__meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </span>
          <span class="post__meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {minutes} мин чтения
          </span>
        </p>
      </header>

      <div class="post__layout">
        <article class="post__content">
          <Content />
        </article>

        {
          toc.length > 1 && (
            <aside class="post__aside" aria-label="Содержание статьи">
              <div class="post__toc">
                <p class="post__toc-title">Содержание</p>
                <ul>
                  {toc.map((h) => (
                    <li class={h.depth === 3 ? 'post__toc-sub' : ''}>
                      <a href={`#${h.slug}`} data-toc-link={h.slug}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )
        }
      </div>

      <div class="post__cta">
        <div>
          <h2 class="post__cta-title">Хватит читать, попробуй сам</h2>
          <p class="post__cta-text">Опиши идею и получи первый результат в первый час. Без карты.</p>
        </div>
        <a href={`${appBase}/register`} data-auth-anon class="pf-btn pf-btn--primary pf-btn--lg">Начать бесплатно</a>
        <a href={`${appBase}/`} data-auth-authed class="pf-btn pf-btn--primary pf-btn--lg">Открыть приложение</a>
      </div>

      {
        related.length > 0 && (
          <section class="post__related" aria-labelledby="related-title">
            <h2 class="post__related-title" id="related-title">Читайте также</h2>
            <ul class="post__related-grid">
              {related.map((r) => (
                <li>
                  <PostCard slug={r.slug} title={r.title} topic={r.topic} date={r.date} minutes={r.minutes} />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Прогресс чтения — полоса синего бренда 2px под мастхедом, растёт трансформацией. */
  .read-progress {
    position: fixed;
    inset: 0 0 auto 0;
    block-size: 2px;
    z-index: var(--z-toast);
    pointer-events: none;
  }
  .read-progress span {
    display: block;
    block-size: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .post {
    padding-block: var(--space-lg) var(--section-gap-s);
  }

  /* Крошки — указатель: «Блог» ссылкой, тема текстом. */
  .post__crumbs {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-end: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .post__crumb {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .post__crumb--current { color: var(--color-ink); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) {
    a.post__crumb:hover { color: var(--color-accent); }
  }
  .post__sep {
    flex: none;
    inline-size: 0.875rem;
    block-size: 0.875rem;
  }

  .post__head {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
    padding-block-end: var(--space-xl);
    border-block-end: var(--rule-bar) solid var(--color-ink);
  }
  .post__topic { color: var(--color-ink-2); }
  .post__title {
    max-inline-size: 22ch;
    font-size: var(--text-display-s);
    text-wrap: balance;
  }
  .post__desc {
    max-inline-size: 60ch;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .post__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .post__meta-item svg {
    flex: none;
    inline-size: 0.9375rem;
    block-size: 0.9375rem;
  }

  /* Раскладка: текст + липкое оглавление справа. */
  .post__layout {
    display: grid;
    /* minmax(0, …): широкая таблица или строка кода не раздвигают колонку — они
       прокручиваются внутри своей обёртки. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xl);
    margin-block-start: var(--space-xl);
  }
  @media (min-width: 65rem) {
    .post__layout { grid-template-columns: minmax(0, 1fr) 16rem; align-items: start; }
  }
  .post__content { max-inline-size: 64ch; }

  /* Проза из Markdown: ритм задаёт родитель, у детей своих внешних отступов нет. */
  .post__content > :global(*) { margin-block: 0; }
  .post__content > :global(* + *) { margin-block-start: var(--flow, 1.1em); }
  .post__content > :global(:is(h2, h3)) { --flow: 2em; }
  .post__content > :global(:is(h2, h3) + *) { --flow: 0.6em; }
  .post__content :global(:is(h2, h3)) { text-wrap: balance; }
  .post__content :global(h2) {
    max-inline-size: none;
    font-size: var(--text-2xl);
    line-height: 1.05;
    scroll-margin-block-start: calc(var(--nav-h) + var(--space-lg));
  }
  .post__content :global(h3) {
    max-inline-size: none;
    font-size: var(--text-lg);
    line-height: 1.15;
    scroll-margin-block-start: calc(var(--nav-h) + var(--space-lg));
  }
  .post__content :global(p),
  .post__content :global(li) {
    font-size: var(--text-md);
    line-height: 1.7;
  }
  .post__content :global(strong) { font-weight: 800; }
  .post__content :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  @media (hover: hover) and (pointer: fine) {
    .post__content :global(a:hover) { color: var(--color-accent); }
  }
  .post__content :global(:is(ul, ol)) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-inline-start: 1.4rem;
  }
  .post__content :global(li::marker) { color: var(--color-muted); }
  /* Цитата — табличка в рамке 2px. */
  .post__content :global(blockquote) {
    padding: var(--space-md) var(--space-lg);
    border: var(--rule-bar) solid var(--color-ink);
    background: var(--color-paper-3);
  }
  .post__content :global(blockquote p) { margin: 0; }
  .post__content :global(code) {
    padding: 0.1em 0.35em;
    background: var(--color-paper-2);
    font-size: 0.92em;
  }
  .post__content :global(pre) {
    padding: var(--space-md);
    border: var(--rule-bar) solid var(--color-ink);
    overflow-x: auto;
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  .post__content :global(pre code) { padding: 0; background: none; font-size: inherit; }
  /* Shiki пишет фон и цвета инлайном: фон — бумага страницы, цвета токенов — по теме. */
  .post__content :global(pre.astro-code) { background-color: var(--color-paper-3) !important; }
  @media (prefers-color-scheme: dark) {
    .post__content :global(.astro-code span) { color: var(--shiki-dark) !important; }
  }
  .post__content :global(hr) {
    block-size: var(--rule-bar);
    border: 0;
    background: var(--color-ink);
  }
  .post__content :global(img) {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    border: var(--rule-bar) solid var(--color-ink);
  }

  /* Таблицы — скрипт оборачивает <table> в .post__table (прокрутка на узких экранах). */
  .post__content :global(.post__table) {
    overflow-x: auto;
    border-block-start: var(--rule-bar) solid var(--color-ink);
  }
  .post__content :global(table) {
    inline-size: 100%;
    min-inline-size: 30rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .post__content :global(:is(th, td)) {
    padding: var(--space-sm) var(--space-md) var(--space-sm) 0;
    border-block-end: var(--rule-hair) solid var(--color-rule);
    text-align: start;
    vertical-align: top;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .post__content :global(thead th) {
    font-weight: 500;
    color: var(--color-muted);
  }

  /* Оглавление: линия 2px слева, текущий пункт — жирным с чернильной меткой. */
  .post__aside { display: none; }
  @media (min-width: 65rem) {
    .post__aside {
      display: block;
      position: sticky;
      inset-block-start: calc(var(--nav-h) + var(--space-lg));
      align-self: start;
    }
  }
  .post__toc-title {
    margin-block-end: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
  }
  .post__toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-inline-start: var(--rule-hair) solid var(--color-rule);
  }
  .post__toc a {
    display: block;
    padding: var(--space-2xs) var(--space-sm);
    margin-inline-start: -1px;
    border-inline-start: var(--rule-bar) solid transparent;
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur-micro) steps(1), border-color var(--dur-micro) steps(1);
  }
  .post__toc-sub a { padding-inline-start: var(--space-lg); }
  @media (hover: hover) and (pointer: fine) {
    .post__toc a:hover { color: var(--color-ink); }
  }
  .post__toc a:global(.is-active) {
    color: var(--color-ink);
    border-inline-start-color: var(--color-ink);
    font-weight: 800;
  }

  /* Призыв в конце статьи — чернильная табличка, как вывеска над доской на главной. */
  .post__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg) var(--space-xl);
    max-inline-size: 64ch;
    margin-block-start: var(--space-3xl);
    padding: var(--space-lg);
    background: var(--color-band);
    color: var(--color-band-ink);
  }
  .post__cta-title {
    max-inline-size: none;
    font-size: var(--text-xl);
    color: var(--color-band-ink);
  }
  .post__cta-text {
    margin-block-start: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-band-muted);
  }

  .post__related { margin-block-start: var(--space-3xl); }
  .post__related-title {
    max-inline-size: none;
    margin-block-end: var(--space-lg);
    font-size: var(--text-title);
  }
  .post__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--gap-columns);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

<script>
  // 1) Прогресс чтения: доля прокрутки в пределах статьи.
  const bar = document.querySelector<HTMLElement>('[data-read-bar]');
  const article = document.querySelector<HTMLElement>('.post__content');
  if (bar && article) {
    const update = (): void => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const pct = total > 0 ? Math.min(100, Math.max(0, (-rect.top / total) * 100)) : 0;
      bar.style.transform = `scaleX(${pct / 100})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }

  // 2) Подсветка текущего раздела в оглавлении.
  const tocLinks = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
    const id = a.getAttribute('data-toc-link');
    if (id) tocLinks.set(id, a);
  });

  if (tocLinks.size > 0) {
    const heads = Array.from(tocLinks.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let activeId = '';
    const setActive = (id: string): void => {
      if (id === activeId) return;
      activeId = id;
      tocLinks.forEach((a, key) => {
        a.classList.toggle('is-active', key === id);
        if (key === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        // Активен самый верхний заголовок в «полосе чтения» у верха экрана.
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-84px 0px -66% 0px', threshold: 0 },
    );
    heads.forEach((h) => io.observe(h));
    if (heads[0]) setActive(heads[0].id);
  }

  // 3) Широкие таблицы — в контейнер с горизонтальной прокруткой.
  if (article) {
    article.querySelectorAll('table').forEach((t) => {
      if (t.parentElement?.classList.contains('post__table')) return;
      const wrap = document.createElement('div');
      wrap.className = 'post__table';
      t.before(wrap);
      wrap.appendChild(t);
    });
  }
</script>
