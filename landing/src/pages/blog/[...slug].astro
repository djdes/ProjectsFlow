---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { readingMinutes, formatDate } from '@/lib/blog';
import { nbspDash } from '@/lib/typo';

const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const minutes = readingMinutes(post.body ?? '');
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const related = [
  ...all.filter((p) => p.data.topic === post.data.topic),
  ...all.filter((p) => p.data.topic !== post.data.topic),
]
  .slice(0, 3)
  .map((p) => ({
    slug: p.id,
    minutes: readingMinutes(p.body ?? ''),
    dateFormatted: formatDate(p.data.date),
    ...p.data,
  }));

const canonical = `https://projectsflow.ru/blog/${post.id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: 'ProjectsFlow',
    url: 'https://projectsflow.ru',
    logo: { '@type': 'ImageObject', url: 'https://projectsflow.ru/og.png' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: 'https://projectsflow.ru/og.png',
  inLanguage: 'ru-RU',
};
---

<BaseLayout title={`${post.data.title} — Журнал ProjectsFlow`} description={post.data.description}>
  <div class="read-progress" aria-hidden="true"><span data-read-bar></span></div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <div
    class="min-h-screen w-full text-white relative overflow-x-clip bg-[#0b0414]"
    style="background-image: radial-gradient(circle at 60% 15%, #9b133d 0%, #3d0c45 45%, #0b0414 90%);"
  >
    <!-- Top Frosted Glass Header -->
    <header class="sticky top-0 z-50 backdrop-blur-2xl bg-[#0c0514]/80 border-b border-white/15">
      <div class="max-w-[1440px] mx-auto px-4 sm:px-8 h-20 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-rose-500/25 border border-white/25 flex items-center justify-center shadow-lg transition-transform group-hover:scale-105">
            <svg class="w-5 h-5 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
              <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>
              <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
            </svg>
          </div>
          <div>
            <span class="font-display font-black text-base sm:text-lg tracking-tight text-white block leading-none">
              ProjectsFlow
            </span>
            <span class="font-mono text-[10px] text-white/60 tracking-wider uppercase block mt-0.5">
              AI Architecture OS
            </span>
          </div>
        </a>

        <nav aria-label="Основная навигация" class="hidden xl:flex items-center gap-1 p-1.5 rounded-2xl bg-white/[0.06] border border-white/15">
          <a href="/#hero" class="px-3.5 py-2 rounded-xl text-xs font-bold text-white/75 hover:text-white transition-colors">
            3D Стек
          </a>
          <a href="/#prompt-sandbox" class="px-3.5 py-2 rounded-xl text-xs font-bold text-white/75 hover:text-white transition-colors">
            Песочница ИИ
          </a>
          <a href="/#walkthrough" class="px-3.5 py-2 rounded-xl text-xs font-bold text-white/75 hover:text-white transition-colors">
            Узлы 01–03
          </a>
          <a href="/#live-board" class="px-3.5 py-2 rounded-xl text-xs font-bold text-white/75 hover:text-white transition-colors">
            Живая доска
          </a>
          <a href="/#pricing" class="px-3.5 py-2 rounded-xl text-xs font-bold text-white/75 hover:text-white transition-colors">
            Тарифы
          </a>
          <a href="/#faq" class="px-3.5 py-2 rounded-xl text-xs font-bold text-white/75 hover:text-white transition-colors">
            FAQ
          </a>
          <a href="/blog/" aria-current="page" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white text-[#12061c] shadow">
            Журнал
          </a>
        </nav>

        <div class="flex items-center gap-2.5">
          <a
            href={`${appBase}/login`}
            data-auth-anon=""
            class="hidden sm:inline-flex items-center px-4 py-2.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.14] border border-white/15 text-xs font-bold text-white transition-all"
          >
            Войти
          </a>
          <a
            href={`${appBase}/login`}
            data-auth-anon=""
            class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2.5 rounded-xl bg-white text-[#12061c] font-extrabold text-xs hover:bg-rose-50 transition-all shadow-md"
          >
            <span>1 час Прайма бесплатно</span>
          </a>
          <a
            href={`${appBase}/projects`}
            data-auth-authed=""
            class="inline-flex items-center gap-1.5 px-4 sm:px-5 py-2.5 rounded-xl bg-white text-[#12061c] font-extrabold text-xs hover:bg-rose-50 transition-all shadow-md"
          >
            <span>В проекты</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main" class="max-w-[1280px] mx-auto px-4 sm:px-8 py-12">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-mono text-white/60 mb-6" aria-label="Хлебные крошки">
        <a href="/" class="hover:text-white transition-colors">Главная</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-white transition-colors">Журнал</a>
        <span>/</span>
        <span class="text-rose-300 font-bold" aria-current="page">{post.data.topic}</span>
      </nav>

      <!-- Article Header Card -->
      <header class="rounded-[34px] p-7 sm:p-11 bg-[#160824]/85 border border-white/20 backdrop-blur-2xl shadow-2xl mb-10">
        <span class="inline-block px-3.5 py-1 rounded-full bg-rose-500/20 border border-rose-400/35 font-mono text-xs font-bold text-rose-200 mb-4">
          #{post.data.topic}
        </span>
        <h1 class="font-display font-black text-2xl sm:text-4xl xl:text-5xl leading-[1.08] tracking-tight text-white mb-4">
          {nbspDash(post.data.title)}
        </h1>
        <p class="text-white/75 text-base sm:text-lg leading-relaxed max-w-3xl mb-6">
          {post.data.description}
        </p>
        <div class="flex flex-wrap items-center gap-5 text-xs font-mono text-white/60 pt-4 border-t border-white/10">
          <span>Автор: <strong class="text-white">{post.data.author}</strong></span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span class="text-amber-300 font-bold">{minutes} мин чтения</span>
        </div>
      </header>

      <!-- Layout: Article + Sticky TOC -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <article class="lg:col-span-8 rounded-[32px] p-7 sm:p-11 bg-[#13061f]/90 border border-white/15 backdrop-blur-xl shadow-2xl post__content">
          <Content />
        </article>

        {
          toc.length > 1 && (
            <aside class="hidden lg:block lg:col-span-4 sticky top-28" aria-label="Содержание статьи">
              <div class="rounded-[26px] p-6 bg-[#160824]/85 border border-white/15 backdrop-blur-xl">
                <p class="font-mono text-xs font-bold uppercase tracking-wider text-rose-300 mb-4">
                  Содержание статьи
                </p>
                <ul class="space-y-2 list-none p-0 m-0">
                  {toc.map((h) => (
                    <li class={h.depth === 3 ? 'pl-4' : ''}>
                      <a
                        href={`#${h.slug}`}
                        data-toc-link={h.slug}
                        class="toc-item block text-xs sm:text-sm text-white/65 hover:text-white transition-colors py-1 border-l-2 border-transparent pl-3"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )
        }
      </div>

      <!-- CTA Box -->
      <div class="rounded-[32px] p-8 sm:p-10 bg-gradient-to-r from-rose-500/25 via-purple-900/40 to-[#160824] border border-rose-400/40 shadow-2xl mt-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <h2 class="font-display font-black text-xl sm:text-2xl text-white mb-1.5">
            Попробуйте ProjectsFlow на своей идее
          </h2>
          <p class="text-sm text-white/75">
            Подписка на Claude уже встроена, а первый час на тарифе «Прайм» — бесплатно.
          </p>
        </div>
        <a
          href={`${appBase}/login`}
          class="shrink-0 inline-flex items-center gap-2 px-7 py-4 rounded-2xl bg-white text-[#12061c] font-extrabold text-sm hover:bg-rose-50 transition-all shadow-lg"
        >
          <span>Начать бесплатно</span>
          <span>→</span>
        </a>
      </div>

      <!-- Related Articles -->
      {
        related.length > 0 && (
          <section class="mt-16" aria-labelledby="related-title">
            <h2 class="font-display font-black uppercase text-2xl sm:text-3xl text-white mb-6" id="related-title">
              Читайте также
            </h2>
            <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 list-none p-0 m-0">
              {related.map((r) => (
                <li>
                  <a
                    href={`/blog/${r.slug}/`}
                    class="group h-full rounded-[26px] p-6 bg-[#150722]/85 border border-white/15 hover:border-rose-400/60 transition-all flex flex-col justify-between"
                  >
                    <div>
                      <div class="flex items-center justify-between text-xs font-mono text-white/55 mb-3">
                        <span class="text-rose-300 font-bold">#{r.topic}</span>
                        <span>{r.minutes} мин</span>
                      </div>
                      <h3 class="font-bold text-base sm:text-lg text-white group-hover:text-rose-300 transition-colors mb-2 line-clamp-2">
                        {r.title}
                      </h3>
                      <p class="text-xs sm:text-sm text-white/65 line-clamp-3">
                        {r.description}
                      </p>
                    </div>
                    <span class="mt-4 inline-block text-xs font-mono font-bold text-rose-300 group-hover:text-white">
                      Читать →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/15 bg-[#0a0412]/90 backdrop-blur-xl mt-16">
      <div class="max-w-[1440px] mx-auto px-4 sm:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/60">
        <div class="flex items-center gap-3">
          <span class="font-bold text-white">ProjectsFlow</span>
          <span>© {new Date().getFullYear()} · Все расчёты в ₽ · Код принадлежит вам</span>
        </div>
        <div class="flex flex-wrap items-center gap-5">
          <a href="/" class="hover:text-white transition-colors">На главную 3D-витрину</a>
          <a href="/blog/" class="hover:text-white transition-colors">Все статьи</a>
          <a href="/#pricing" class="hover:text-white transition-colors">Тарифы</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .read-progress {
    position: fixed;
    inset: 0 0 auto 0;
    block-size: 3px;
    z-index: 60;
    pointer-events: none;
  }
  .read-progress span {
    display: block;
    block-size: 100%;
    background: linear-gradient(90deg, #ff2e63, #ffe66d);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .post__content > :global(*) { margin-block: 0; }
  .post__content > :global(* + *) { margin-block-start: 1.15em; }
  .post__content :global(h2) {
    font-family: 'Unbounded Variable', system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.2;
    color: #ffffff;
    margin-block-start: 1.8em;
    scroll-margin-block-start: 6.5rem;
  }
  .post__content :global(h3) {
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.3;
    color: #fda4af;
    margin-block-start: 1.5em;
    scroll-margin-block-start: 6.5rem;
  }
  .post__content :global(p),
  .post__content :global(li) {
    font-size: 1.02rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.84);
  }
  .post__content :global(strong) {
    color: #ffffff;
    font-weight: 800;
  }
  .post__content :global(a) {
    color: #fda4af;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .post__content :global(:is(ul, ol)) {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-inline-start: 1.4rem;
  }
  .post__content :global(blockquote) {
    padding: 1rem 1.25rem;
    border-left: 4px solid #ff2e63;
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.05);
  }
  .post__content :global(code) {
    padding: 0.15em 0.4em;
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.1);
    font-size: 0.9em;
    color: #fde047;
  }
  .post__content :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #090310 !important;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .post__content :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
  }
  .post__content :global(.post__table) {
    overflow-x: auto;
    border-radius: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.5rem;
  }
  .post__content :global(table) {
    inline-size: 100%;
    min-inline-size: 30rem;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .post__content :global(:is(th, td)) {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    text-align: start;
  }
  .toc-item:global(.is-active) {
    color: #ffffff;
    border-left-color: #ff2e63;
    font-weight: 700;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-read-bar]');
  const article = document.querySelector<HTMLElement>('.post__content');
  if (bar && article) {
    const update = (): void => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const pct = total > 0 ? Math.min(100, Math.max(0, (-rect.top / total) * 100)) : 0;
      bar.style.transform = `scaleX(${pct / 100})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }

  const tocLinks = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
    const id = a.getAttribute('data-toc-link');
    if (id) tocLinks.set(id, a);
  });

  if (tocLinks.size > 0) {
    const heads = Array.from(tocLinks.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let activeId = '';
    const setActive = (id: string): void => {
      if (id === activeId) return;
      activeId = id;
      tocLinks.forEach((a, key) => {
        a.classList.toggle('is-active', key === id);
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-96px 0px -66% 0px', threshold: 0 },
    );
    heads.forEach((h) => io.observe(h));
    if (heads[0]) setActive(heads[0].id);
  }

  if (article) {
    article.querySelectorAll('table').forEach((t) => {
      if (t.parentElement?.classList.contains('post__table')) return;
      const wrap = document.createElement('div');
      wrap.className = 'post__table';
      t.before(wrap);
      wrap.appendChild(t);
    });
  }
</script>
