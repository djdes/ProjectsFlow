---
import KanbanBoard from './KanbanBoard.tsx';
import { nbspDash } from '@/lib/typo';

// Лендинг и SPA — один Express в prod, пути относительные.
const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');

// Три опоры продукта — тихий ряд под доской.
const points = [
  {
    key: 'llm',
    title: 'Подписка на Claude — уже внутри',
    text: 'Онлайн-доступ к ведущим LLM. Без VPN и без своих API-ключей — просто работаешь.',
  },
  {
    key: 'money',
    title: 'Прибыль и траты — понятным языком',
    text: 'Видно, сколько проект заработал и сколько потратил. Без таблиц и лишних терминов.',
  },
  {
    key: 'auto',
    title: 'Автоматизации из коробки',
    text: 'Автоулучшения, проверки безопасности и доска, где задачи выполняет AI.',
  },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="pf-container">
    <div class="hero__top">
      <h1 id="hero-title" class="hero__title">Опиши идею&nbsp;— получи готовый продукт</h1>

      <div class="hero__side">
        <p class="hero__lead">
          Подписка на Claude уже внутри, проект на автопилоте, а прибыль и траты — понятным
          языком. Без VPN, своих ключей и лишней настройки.
        </p>

        <form class="hero__form" data-auth-anon data-hero-start data-app-base={appBase}>
          <label class="sr-only" for="hero-email">E-mail для старта</label>
          <input
            id="hero-email"
            type="email"
            name="email"
            class="hero__email"
            placeholder="Твой e-mail"
            autocomplete="email"
          />
          <button type="submit" class="pf-btn pf-btn--primary pf-btn--lg">Начать бесплатно</button>
        </form>
        <a href={`${appBase}/`} data-auth-authed class="pf-btn pf-btn--primary pf-btn--lg hero__authed">
          Открыть приложение
        </a>

        <p class="hero__note">
          Первый час на Прайме — бесплатно и без карты. Не зашло — вернём деньги, а проект
          в любом случае остаётся твоим.
        </p>
        <p class="hero__login" data-auth-anon>
          Уже есть аккаунт? <a href={`${appBase}/login`} class="pf-link">Войти</a>
        </p>
      </div>
    </div>

    <div class="hero__board">
      <KanbanBoard client:visible />
      <p class="hero__caption">
        Это живая доска. Нажми на задачу — её возьмёт AI.
        <span class="hero__caption-fine">Перетащи карточку в «Сейчас» — сделаешь сам.</span>
        <span class="hero__caption-touch">Удерживай карточку и тащи в «Сейчас» — сделаешь сам.</span>
        Готовое приходит на утверждение.
      </p>
    </div>

    <ul class="hero__points">
      {
        points.map((p) => (
          <li class="hero__point">
            <svg class="hero__point-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              {p.key === 'llm' && <path d="M13 3 4 14h7l-1 7 9-11h-7l1-7Z" stroke-linecap="round" stroke-linejoin="round" />}
              {p.key === 'money' && <path d="M4 19V9m5 10V5m5 14v-6m5 6V8" stroke-linecap="round" stroke-linejoin="round" />}
              {p.key === 'auto' && (
                <>
                  <circle cx="12" cy="12" r="3.2" />
                  <path
                    d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8"
                    stroke-linecap="round"
                  />
                </>
              )}
            </svg>
            <p class="hero__point-title">{nbspDash(p.title)}</p>
            <p class="hero__point-text">{p.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) var(--section-y);
  }

  /* Заголовок слева, справа — лид и старт. На узких экранах — столбиком. */
  .hero__top {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .hero__top { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
  .hero__title {
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: var(--tracking-display);
    color: oklch(var(--foreground));
  }
  .hero__side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hero__lead {
    max-inline-size: var(--measure);
    font-size: var(--text-lead);
    line-height: var(--leading-body);
    color: oklch(var(--muted-foreground));
  }

  .hero__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-inline-size: 30rem;
  }
  .hero__email {
    flex: 1 1 13rem;
    min-inline-size: 0;
    min-block-size: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid oklch(var(--input));
    border-radius: var(--r-md);
    background: oklch(var(--field));
    color: oklch(var(--foreground));
    font: inherit;
    font-size: max(16px, 1rem);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .hero__email::placeholder { color: oklch(var(--muted-foreground)); }
  .hero__email:focus-visible {
    border-color: oklch(var(--primary));
    outline: 3px solid color-mix(in oklch, oklch(var(--primary)) 28%, transparent);
    outline-offset: 0;
  }
  .hero__form .pf-btn { flex: 1 0 auto; }
  .hero__authed { align-self: flex-start; }

  .hero__note,
  .hero__login {
    max-inline-size: 30rem;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: oklch(var(--muted-foreground));
  }
  .hero__login { margin-block-start: -0.375rem; }

  /* Доска — главный визуальный ход: сам продукт на всю ширину контейнера. */
  .hero__board {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-block-start: clamp(2rem, 1.25rem + 2.5vw, 3rem);
  }
  .hero__caption-touch { display: none; }
  @media (pointer: coarse) {
    .hero__caption-fine { display: none; }
    .hero__caption-touch { display: inline; }
  }
  .hero__caption {
    max-inline-size: 46rem;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: oklch(var(--muted-foreground));
  }

  /* Три опоры — тихий ряд без карточек. */
  .hero__points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.75rem 2.5rem;
    margin: clamp(3rem, 2rem + 3vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .hero__point {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    align-items: start;
  }
  .hero__point-ic {
    grid-row: span 2;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-block-start: 0.125rem;
    color: oklch(var(--muted-foreground));
  }
  .hero__point-title {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: oklch(var(--foreground));
  }
  .hero__point-text {
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: oklch(var(--muted-foreground));
  }
</style>

<script>
  // Быстрый старт: e-mail из hero → регистрация с предзаполнением. Без e-mail — просто регистрация.
  const form = document.querySelector<HTMLFormElement>('[data-hero-start]');
  if (form) {
    const base = (form.getAttribute('data-app-base') ?? '').replace(/\/+$/, '');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email');
      const q = typeof email === 'string' && email.includes('@') ? `?email=${encodeURIComponent(email)}` : '';
      window.location.href = `${base}/register${q}`;
    });
  }
</script>
