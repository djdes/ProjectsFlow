---
import KanbanBoard from './KanbanBoard.tsx';

// Лендинг и SPA — один Express в prod, пути относительные.
const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');
---

<!-- Hero «Banner»: фраза во всю ширину контейнера, под линией 2px лид и старт. Доска
     начинается выше сгиба: она и есть главный визуальный ход. -->
<section class="hero" aria-labelledby="hero-title">
  <div class="pf-container">
    <h1 id="hero-title" class="hero__title">Опиши идею.<br />Получи готовый продукт.</h1>

    <div class="hero__foot">
      <p class="hero__lead">Подписка на Claude уже внутри: без VPN, своих ключей и&nbsp;лишней настройки.</p>

      <div class="hero__start">
        <form class="hero__form" data-auth-anon data-hero-start data-app-base={appBase}>
          <label class="visually-hidden" for="hero-email">E-mail для старта</label>
          <input
            id="hero-email"
            type="email"
            name="email"
            class="hero__email"
            placeholder="Твой e-mail"
            autocomplete="email"
          />
          <button type="submit" class="pf-btn pf-btn--primary pf-btn--lg">Начать бесплатно</button>
        </form>
        <a href={`${appBase}/`} data-auth-authed class="pf-btn pf-btn--primary pf-btn--lg hero__authed">
          Открыть приложение
        </a>
        <p class="hero__note">
          Первый час на Прайме бесплатно и без карты.
          <span data-auth-anon class="hero__login">Уже есть аккаунт? <a href={`${appBase}/login`} class="pf-link">Войти</a></span>
        </p>
      </div>
    </div>
  </div>
</section>

<section class="stage" aria-label="Живая доска">
  <div class="pf-container">
    <figure class="stage__figure">
      <div class="stage__sign">
        <span class="stage__name">Это живая доска.</span>
        <span class="stage__how">Нажми на задачу: её возьмёт AI.</span>
      </div>
      <div class="stage__frame pf-product">
        <KanbanBoard client:visible />
      </div>
      <figcaption class="stage__caption">
        <span class="stage__fine">Перетащи карточку в «Сейчас»: сделаешь сам.</span>
        <span class="stage__touch">Удерживай карточку и тащи в «Сейчас»: сделаешь сам.</span>
        Готовое приходит на утверждение.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-xl);
  }
  /* Wayfind: моно идёт широко, поэтому фраза не выше 4.75rem; пробел моно — целая клетка,
     её поджимаем, чтобы между словами не зияло. */
  .hero__title {
    max-inline-size: none;
    font-size: min(var(--text-display), 4.75rem);
    line-height: 0.96;
    word-spacing: -0.2em;
    text-wrap: balance;
  }

  /* Под фразой — линия 2px; слева лид, справа старт. На узких — столбиком. */
  .hero__foot {
    display: grid;
    gap: var(--space-lg) var(--gap-columns);
    align-items: start;
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-bar) solid var(--color-ink);
  }
  @media (min-width: 60rem) {
    .hero__foot { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: calc(var(--gap-columns) * 3); }
  }
  .hero__lead {
    max-inline-size: 42ch;
    font-size: var(--text-lead);
    font-weight: 500;
    line-height: 1.4;
  }

  .hero__start {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .hero__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .hero__email {
    flex: 1 1 14rem;
    min-inline-size: 0;
    min-block-size: 52px;
    padding-inline: var(--space-md);
    border: var(--rule-bar) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper-3);
    color: var(--color-ink);
    font-size: max(16px, var(--text-md));
    outline: 2px solid transparent;
    outline-offset: -5px;
  }
  .hero__email::placeholder { color: var(--color-muted); opacity: 1; }
  .hero__email:focus-visible { outline-color: var(--color-focus); }
  .hero__form .pf-btn { flex: 1 0 auto; }
  .hero__authed { align-self: flex-start; }

  .hero__note {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-muted);
  }
  .hero__login { white-space: nowrap; }

  /* Доска под вывеской: табличка чернилами сверху, рамка 2px, внутри — вид приложения. */
  .stage { padding-block-end: var(--section-gap-s); }
  .stage__figure { margin: 0; }
  .stage__sign {
    display: grid;
    gap: var(--space-2xs) var(--gap-columns);
    padding: var(--space-sm) var(--space-md);
    border: var(--rule-bar) solid var(--color-ink);
    background: var(--color-band);
    color: var(--color-band-ink);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  @media (min-width: 60rem) {
    .stage__sign { grid-template-columns: auto minmax(0, 1fr); align-items: baseline; }
  }
  .stage__name {
    font-size: var(--text-md);
    color: var(--color-band-ink);
    font-stretch: var(--stretch-display);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }
  .stage__how { color: var(--color-band-muted); }
  .stage__touch { display: none; }
  @media (pointer: coarse) {
    .stage__fine { display: none; }
    .stage__touch { display: inline; }
  }
  .stage__frame {
    border: var(--rule-bar) solid var(--color-ink);
    border-block-start: 0;
  }
  .stage__caption {
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-muted);
  }
  /* Своя рамка доски (скругление и тень окна) не нужна: окно держит рамка вывески. */
  .stage__frame :global(.kb) {
    border-radius: 0;
    box-shadow: none;
  }
</style>

<script>
  // Быстрый старт: e-mail из hero → регистрация с предзаполнением. Без e-mail — просто регистрация.
  const form = document.querySelector<HTMLFormElement>('[data-hero-start]');
  if (form) {
    const base = (form.getAttribute('data-app-base') ?? '').replace(/\/+$/, '');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email');
      const q = typeof email === 'string' && email.includes('@') ? `?email=${encodeURIComponent(email)}` : '';
      window.location.href = `${base}/register${q}`;
    });
  }
</script>
