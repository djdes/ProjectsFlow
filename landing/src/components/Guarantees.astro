---
// Снятие риска: только реальные обещания — возврат денег, нет лок-ина, старт без карты,
// помощь. Никаких выдуманных цифр результата. Стоит сразу под тарифами, на той же полосе:
// четыре таблички и бонусы. Печать «Не зашло — вернём деньги» и список «Что получаешь»
// сняты: они повторяли табличку «Вернём деньги» и возможности выше (гейт 69 Hallmark).
import { nbspDash } from '@/lib/typo';

const risks = [
  {
    title: 'Первый час бесплатно',
    body: 'Прайм можно попробовать час без карты. Первый результат увидишь уже в первый час.',
  },
  {
    title: 'Вернём деньги',
    body: 'Платный тариф не подошёл, оформим возврат. Без допросов и мелкого шрифта.',
  },
  {
    title: 'Не получилось? Поможем',
    body: 'Застрял или что-то не вышло, поможем бесплатно. Не бросаем наедине с проблемой.',
  },
  {
    title: 'Никакого лок-ина',
    body: 'Всё, что создаёшь, твоё. Уходишь, забираешь с собой. Ничего не запираем.',
  },
];

const bonuses = [
  'Поможем запустить первый проект: проведём за руку',
  'Готовые шаблоны и стартеры, чтобы начать быстрее',
  'Приоритетная поддержка в Telegram',
];
---

<section id="guarantee" class="pf-band--paper guarantee" aria-labelledby="guarantee-title">
  <div class="pf-container">
    <h2 id="guarantee-title" class="guarantee__title">Почему не страшно начать</h2>
    <ul class="guarantee__plates">
      {
        risks.map((r) => (
          <li class="guarantee__plate">
            <h3 class="guarantee__plate-title">{nbspDash(r.title)}</h3>
            <p class="guarantee__plate-body">{r.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="guarantee__bonus">
      <h3 class="guarantee__bonus-title">Бонусы бесплатно</h3>
      <ul class="guarantee__bonus-list">
        {bonuses.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .guarantee { padding-block: var(--space-2xl) var(--section-gap-s); }
  .guarantee__title {
    max-inline-size: none;
    font-size: var(--text-title);
  }

  /* Четыре таблички на общих рамках 2px: одно обещание в каждой. */
  .guarantee__plates {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--rule-bar) solid var(--color-ink);
    border-inline-start: var(--rule-bar) solid var(--color-ink);
  }
  .guarantee__plate {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border-inline-end: var(--rule-bar) solid var(--color-ink);
    border-block-end: var(--rule-bar) solid var(--color-ink);
    background: var(--color-paper-3);
  }
  .guarantee__plate-title { font-size: var(--text-lg); }
  .guarantee__plate-body {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .guarantee__bonus {
    display: grid;
    gap: var(--space-sm) var(--gap-columns);
    margin-block-start: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .guarantee__bonus { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); align-items: baseline; }
  }
  .guarantee__bonus-title {
    max-inline-size: none;
    font-size: var(--text-lg);
  }
  .guarantee__bonus-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .guarantee__bonus-list li {
    display: flex;
    gap: var(--space-xs);
    align-items: baseline;
  }
  .guarantee__bonus-list li::before {
    content: '+';
    font-weight: 800;
    color: var(--color-accent);
  }
</style>
