---
// Окна приложения для вкладок «Меньше рутины, больше готового» (Features.astro): вёрстка в
// стиле C4, как доска в hero, а не скриншоты. Так окна совпадают с текущим видом приложения,
// остаются чёткими на любом экране и сами переключаются в тёмную тему. Значения в окнах —
// примеры. Снаружи окно держит рамка Wayfind (2px чернилами), внутри — вид приложения.
interface Props {
  view: 'idea' | 'live' | 'autopilot' | 'checks' | 'money' | 'ops' | 'plans';
}
const { view } = Astro.props as Props;

const live = [
  { text: 'Прочитал задачу и структуру сайта', done: true },
  { text: 'Собрал страницу меню: 12 позиций', done: true },
  { text: 'Сжал фото для телефона', done: true },
  { text: 'Проверяю вёрстку на телефоне', done: false },
];

const checks = ['Сборка проходит без ошибок', 'Линтер и типы чистые', 'Секреты не попали в код', 'Адаптив на телефоне'];

const money = [
  { label: 'Доход', value: '214 000 ₽' },
  { label: 'Расходы', value: '85 600 ₽' },
  { label: 'Прибыль', value: '128 400 ₽', note: 'маржа 60%' },
];

// Прибыль по месяцам, тыс. ₽ — для мини-графика в окне «Финансы».
const profit = [
  { m: 'фев', v: 38 },
  { m: 'мар', v: 52 },
  { m: 'апр', v: 47 },
  { m: 'май', v: 81 },
  { m: 'июн', v: 96 },
  { m: 'июл', v: 128 },
];
const profitMax = Math.max(...profit.map((p) => p.v));

const rows = [
  { title: 'Оплата от клиента', tag: 'Клиент', date: '1 июля', sum: '+214 000 ₽', income: true },
  { title: 'AI-бюджет и сервисы', tag: 'AI', date: '1 июля', sum: '−85 600 ₽', income: false },
  { title: 'Домен и хостинг', tag: 'Хостинг', date: '3 июля', sum: '−1 900 ₽', income: false },
  { title: 'Предоплата за бота', tag: 'Клиент', date: '5 июля', sum: '+40 000 ₽', income: true },
  { title: 'Подписка на Прайм', tag: 'AI', date: '8 июля', sum: '−1 900 ₽', income: false },
  { title: 'Доработка меню', tag: 'Клиент', date: '12 июля', sum: '+12 000 ₽', income: true },
];

const check =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
---

{
  view === 'idea' && (
    <div class="sh__win sh__win--loose pf-product" role="img" aria-label="Задача словами «Собери лендинг для запуска» и готовая карточка задачи">
      <div class="sh__body">
        <div class="ui-composer">
          <span class="ui-composer__text">Собери лендинг для запуска</span>
          <span class="ui-composer__send">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
          </span>
        </div>
        <div class="ui-card">
          <span class="ui-card__title">Собрать лендинг для запуска</span>
          <span class="ui-card__note">Hero, тарифы, форма заявки по описанию</span>
          <span class="ui-card__meta">
            <span class="pf-tag pf-tone-done"><span class="pf-tag__text">Готово</span></span>
            <span class="ui-muted">за 14 минут</span>
          </span>
        </div>
      </div>
    </div>
  )
}

{
  view === 'live' && (
    <div class="sh__win pf-product" role="img" aria-label="Задача «Меню с ценами и фото»: AI выполнил три шага из четырёх, потрачено 3,20 ₽">
      <div class="sh__bar">
        <span class="pf-tag pf-tone-orange"><span class="pf-tag__text">Сайт кофейни</span></span>
        <span class="sh__crumb">Меню с ценами и фото</span>
        <span class="pf-tag pf-tone-queue sh__end"><span class="pf-tag__text">AI делает</span></span>
      </div>
      <ul class="sh__body live">
        {live.map((l) => (
          <li class:list={['live__row', !l.done && 'live__row--now']}>
            {l.done ? <span class="live__ic live__ic--done" set:html={check} /> : <span class="live__ic live__ic--now" />}
            {l.text}
          </li>
        ))}
      </ul>
      <div class="sh__foot">
        <span class="live__track"><span class="live__fill" /></span>
        <span class="live__num">84%</span>
        <span class="live__num">3,20&nbsp;₽</span>
      </div>
    </div>
  )
}

{
  view === 'autopilot' && (
    <div class="sh__win sh__win--loose pf-product" role="img" aria-label="Автопилот включён: два шага сделаны, AI пишет тесты оплаты">
      <div class="sh__body">
        <div class="ui-card ui-pilot">
          <span class="ui-pilot__head">
            <span class="ui-card__title">Автопилот</span>
            <span class="ui-switch"><span /></span>
          </span>
          <ul class="ui-steps">
            <li class="ui-step">
              <span class="live__ic live__ic--done" set:html={check} />
              Настроил проверку сборки
            </li>
            <li class="ui-step">
              <span class="live__ic live__ic--done" set:html={check} />
              Починил формы на телефоне
            </li>
            <li class="ui-step ui-step--now">
              <span class="live__ic live__ic--now" />
              Пишет тесты оплаты
              <span class="ui-run">AI делает</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  )
}

{
  view === 'checks' && (
    <div class="sh__win pf-product" role="img" aria-label="Автопроверки: четыре из четырёх пройдены, готово к выкатке">
      <div class="sh__bar">
        <span class="sh__crumb sh__crumb--strong">Автопроверки</span>
        <span class="pf-tag pf-tone-done sh__end"><span class="pf-tag__text">4 из 4</span></span>
      </div>
      <ul class="sh__body">
        {checks.map((c) => (
          <li class="live__row checks__row">
            <span class="live__ic live__ic--done" set:html={check} />
            {c}
          </li>
        ))}
      </ul>
      <div class="sh__foot">
        <span class="pf-tag pf-tone-done"><span class="pf-tag__text">Готово к выкатке</span></span>
      </div>
    </div>
  )
}

{
  view === 'money' && (
    <div class="sh__win pf-product" role="img" aria-label="Финансы проекта: доход 214 000 ₽, расходы 85 600 ₽, прибыль 128 400 ₽, маржа 60%. Прибыль растёт с февраля по июль">
      <div class="sh__bar">
        <span class="pf-tag pf-tone-green"><span class="pf-tag__text">Бот записи</span></span>
        <span class="sh__crumb">Финансы</span>
      </div>
      <div class="sh__body money">
        {money.map((m) => (
          <div class="money__tile">
            <span class="money__label">{m.label}</span>
            <span class="money__value">{m.value}</span>
            {m.note && <span class="money__note">{m.note}</span>}
          </div>
        ))}
      </div>
      <div class="sh__foot chart">
        <span class="chart__title">Прибыль по месяцам</span>
        <span class="chart__bars">
          {profit.map((p, i) => (
            <span class="chart__col">
              <span
                class:list={['chart__bar', i === profit.length - 1 && 'chart__bar--now']}
                style={`--h: ${Math.round((p.v / profitMax) * 100)}%`}
              />
              <span class="chart__m">{p.m}</span>
            </span>
          ))}
        </span>
      </div>
    </div>
  )
}

{
  view === 'ops' && (
    <div class="sh__win pf-product" role="img" aria-label="Список операций за июль: оплаты клиентов, AI-бюджет, домен и хостинг, подписка">
      <div class="sh__bar">
        <span class="sh__crumb sh__crumb--strong">Операции</span>
        <span class="sh__crumb sh__end">Июль</span>
      </div>
      <ul class="sh__body ops">
        {rows.map((r) => (
          <li class="ops__row">
            <span class="ops__title">{r.title}</span>
            <span class="pf-tag pf-tone-gray ops__tag"><span class="pf-tag__text">{r.tag}</span></span>
            <span class="ops__date">{r.date}</span>
            <span class:list={['ops__sum', r.income && 'ops__sum--in']}>{r.sum}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  view === 'plans' && (
    <div class="sh__win pf-product" role="img" aria-label="Подписки Claude: от ProjectsFlow на Прайме и VIP онлайн, своя подписка на бесплатном тарифе">
      <ul class="sh__body ui-plans">
        <li class="ui-plan">
          <span class="ui-plan__name">Claude от ProjectsFlow</span>
          <span class="pf-tag pf-tone-blue"><span class="pf-tag__text">Прайм</span></span>
          <span class="ui-online">онлайн</span>
        </li>
        <li class="ui-plan">
          <span class="ui-plan__name">Claude для команды</span>
          <span class="pf-tag pf-tone-brown"><span class="pf-tag__text">VIP</span></span>
          <span class="ui-online">онлайн</span>
        </li>
        <li class="ui-plan">
          <span class="ui-plan__name">Своя подписка Claude</span>
          <span class="pf-tag pf-tone-gray"><span class="pf-tag__text">Бесплатный</span></span>
          <span class="ui-muted">подключить</span>
        </li>
      </ul>
    </div>
  )
}

<style>
  /* Окно приложения: рамка 2px чернилами снаружи (Wayfind), внутри лист приложения. */
  .sh__win {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    border: var(--rule-bar) solid var(--color-ink);
    background: oklch(var(--card));
    overflow: clip;
  }
  .sh__win--loose { background: oklch(var(--panel)); }
  .sh__bar {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-inline-size: 0;
    min-block-size: 2.5rem;
    padding-inline: 0.875rem;
    border-block-end: 1px solid oklch(var(--border));
  }
  .sh__crumb {
    min-inline-size: 0;
    font-size: var(--text-ui);
    color: oklch(var(--muted-foreground));
    white-space: nowrap;
    overflow: clip;
    text-overflow: ellipsis;
  }
  .sh__crumb--strong { color: oklch(var(--foreground)); font-weight: 600; }
  .sh__end { margin-inline-start: auto; flex: none; }
  .sh__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0.875rem;
    list-style: none;
  }
  .sh__foot {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-start: auto;
    padding: var(--space-sm) 0.875rem;
    border-block-start: 1px solid oklch(var(--border));
  }

  /* Карточка, композер, автопилот — фрагменты доски. */
  .ui-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: 7px 10px;
    border-radius: var(--r-lg);
    background: oklch(var(--card));
    box-shadow: var(--shadow-card);
  }
  .ui-card__title {
    font-size: var(--text-card);
    font-weight: 600;
    line-height: 1.3;
    color: oklch(var(--foreground));
  }
  .ui-card__note,
  .ui-muted {
    font-size: var(--text-meta);
    line-height: var(--leading-snug);
    color: oklch(var(--muted-foreground));
  }
  .ui-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    margin-block-start: var(--space-2xs);
  }
  .ui-composer {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: 2.5rem;
    padding: 0.375rem 0.375rem 0.375rem var(--space-sm);
    border-radius: var(--r-lg);
    background: oklch(var(--field));
    box-shadow: var(--shadow-card);
  }
  .ui-composer__text {
    flex: 1;
    min-inline-size: 0;
    font-size: var(--text-sm);
    color: oklch(var(--foreground));
    white-space: nowrap;
    overflow: clip;
    text-overflow: ellipsis;
  }
  .ui-composer__send {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: var(--r-md);
    background: oklch(var(--primary-fill));
    color: oklch(var(--primary-foreground));
  }
  .ui-composer__send svg { inline-size: 0.875rem; block-size: 0.875rem; }
  .ui-pilot { gap: var(--space-xs); padding-block: 0.625rem; }
  .ui-pilot__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }
  .ui-switch {
    display: inline-flex;
    justify-content: flex-end;
    inline-size: 1.75rem;
    block-size: 1rem;
    padding: var(--space-3xs);
    border-radius: var(--r-full);
    background: oklch(var(--primary));
  }
  .ui-switch span {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: 50%;
    background: oklch(var(--card));
  }
  .ui-steps {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ui-step {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    font-size: var(--text-ui);
    color: oklch(var(--muted-foreground));
  }
  .ui-step--now { color: oklch(var(--foreground)); font-weight: 500; }
  .ui-run {
    font-size: var(--text-xs);
    font-weight: 500;
    color: oklch(var(--primary-ink));
  }

  /* Живой ход задачи и проверки. */
  .live__row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-sm);
    color: oklch(var(--muted-foreground));
  }
  .checks__row { color: oklch(var(--foreground)); }
  .live__row--now { color: oklch(var(--foreground)); font-weight: 500; }
  .live__ic {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 1.125rem;
    block-size: 1.125rem;
    border-radius: 50%;
  }
  .live__ic :global(svg) { inline-size: 0.6875rem; block-size: 0.6875rem; }
  .live__ic--done {
    background: var(--done-soft);
    color: oklch(var(--done-ink));
  }
  .live__ic--now::before {
    content: '';
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: oklch(var(--primary));
  }
  .live__track {
    flex: 1;
    block-size: 0.375rem;
    border-radius: var(--r-full);
    background: color-mix(in oklch, oklch(var(--primary)) 16%, transparent);
    overflow: clip;
  }
  .live__fill {
    display: block;
    inline-size: 84%;
    block-size: 100%;
    border-radius: inherit;
    background: oklch(var(--primary));
  }
  .live__num {
    font-size: var(--text-ui);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: oklch(var(--foreground));
  }

  /* Деньги: три плитки и график. */
  .money {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: var(--space-xs);
  }
  .money__tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: 0.625rem var(--space-sm);
    border-radius: var(--r-lg);
    background: oklch(var(--panel));
  }
  .money__label,
  .money__note {
    font-size: var(--text-meta);
    color: oklch(var(--muted-foreground));
  }
  .money__value {
    font-size: var(--text-h3);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    font-variant-numeric: tabular-nums;
    color: oklch(var(--foreground));
    white-space: nowrap;
  }
  .chart {
    flex-direction: column;
    align-items: stretch;
    gap: 0.625rem;
    padding-block: 0.875rem;
  }
  .chart__title {
    font-size: var(--text-ui);
    font-weight: 600;
    color: oklch(var(--foreground));
  }
  .chart__bars {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-xs);
    block-size: 6.5rem;
  }
  .chart__col {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.375rem;
  }
  .chart__bar {
    align-self: end;
    block-size: var(--h);
    border-radius: 3px;
    background: color-mix(in oklch, oklch(var(--muted-foreground)) 24%, transparent);
  }
  .chart__bar--now { background: oklch(var(--primary)); }
  .chart__m {
    font-size: var(--text-xs);
    color: oklch(var(--muted-foreground));
    text-align: center;
  }

  /* Операции: строки с линиями. */
  .ops { gap: 0; padding-block: var(--space-2xs); }
  .ops__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
    padding-block: 0.625rem;
  }
  .ops__row + .ops__row { border-block-start: 1px solid oklch(var(--border)); }
  .ops__title {
    min-inline-size: 0;
    font-size: var(--text-sm);
    color: oklch(var(--foreground));
    white-space: nowrap;
    overflow: clip;
    text-overflow: ellipsis;
  }
  .ops__date {
    font-size: var(--text-meta);
    color: oklch(var(--muted-foreground));
    white-space: nowrap;
  }
  .ops__sum {
    min-inline-size: 6.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: end;
    color: oklch(var(--foreground));
    white-space: nowrap;
  }
  .ops__sum--in { color: oklch(var(--done-ink)); }
  @media (prefers-color-scheme: dark) {
    .ops__sum--in { color: oklch(var(--done)); }
  }
  @container (width < 30rem) {
    .ops__row { grid-template-columns: minmax(0, 1fr) auto; }
    .ops__tag { display: none; }
    .ops__title { grid-column: 1; grid-row: 1; }
    .ops__date { grid-column: 1; grid-row: 2; }
    .ops__sum { grid-column: 2; grid-row: 1 / span 2; }
    .money { grid-template-columns: 1fr 1fr; }
    .money__tile:last-child { grid-column: 1 / -1; }
  }

  /* Подписки: от нас — онлайн, своя — подключаешь. */
  .ui-plans { gap: 0; padding-block: var(--space-2xs); }
  .ui-plan {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem var(--space-xs);
    padding-block: var(--space-sm);
  }
  .ui-plan + .ui-plan { border-block-start: 1px solid oklch(var(--border)); }
  .ui-plan__name {
    flex: 1 1 10rem;
    min-inline-size: 0;
    font-size: var(--text-card);
    font-weight: 600;
    color: oklch(var(--foreground));
  }
  .ui-online {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    font-size: var(--text-meta);
    color: oklch(var(--muted-foreground));
  }
  /* Точка — живое состояние подписки «онлайн», как в приложении. */
  .ui-online::before {
    content: '';
    inline-size: 0.4375rem;
    block-size: 0.4375rem;
    border-radius: 50%;
    background: oklch(var(--done));
  }
</style>
