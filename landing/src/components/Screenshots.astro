---
// «Внутри продукта»: окна приложения, свёрстанные в том же стиле C4, что и доска в hero.
// Вёрстка, а не скриншоты: так окна совпадают с текущим видом приложения, остаются чёткими
// на любом экране и сами переключаются в тёмную тему.

const live = [
  { text: 'Прочитал задачу и структуру сайта', done: true },
  { text: 'Собрал страницу меню: 12 позиций', done: true },
  { text: 'Сжал фото для телефона', done: true },
  { text: 'Проверяю вёрстку на телефоне', done: false },
];

const checks = ['Сборка проходит без ошибок', 'Линтер и типы — чисто', 'Секреты не попали в код', 'Адаптив на телефоне'];

const money = [
  { label: 'Доход', value: '214 000 ₽' },
  { label: 'Расходы', value: '85 600 ₽' },
  { label: 'Прибыль', value: '128 400 ₽', note: 'маржа 60%' },
];

// Прибыль по месяцам, тыс. ₽ — для мини-графика в окне «Финансы».
const profit = [
  { m: 'фев', v: 38 },
  { m: 'мар', v: 52 },
  { m: 'апр', v: 47 },
  { m: 'май', v: 81 },
  { m: 'июн', v: 96 },
  { m: 'июл', v: 128 },
];
const profitMax = Math.max(...profit.map((p) => p.v));

const rows = [
  { title: 'Оплата от клиента', tag: 'Клиент', date: '1 июля', sum: '+214 000 ₽', income: true },
  { title: 'AI-бюджет и сервисы', tag: 'AI', date: '1 июля', sum: '−85 600 ₽', income: false },
  { title: 'Домен и хостинг', tag: 'Хостинг', date: '3 июля', sum: '−1 900 ₽', income: false },
  { title: 'Предоплата за бота', tag: 'Клиент', date: '5 июля', sum: '+40 000 ₽', income: true },
  { title: 'Подписка на Прайм', tag: 'AI', date: '8 июля', sum: '−1 900 ₽', income: false },
  { title: 'Доработка меню', tag: 'Клиент', date: '12 июля', sum: '+12 000 ₽', income: true },
];

const examples = [
  'Собери лендинг для запуска',
  'Добавь экран оплаты',
  'Сделай тёмную тему',
  'Подключи Telegram-бота',
  'Почини баг и выкати',
  'Автоматизируй рутину проекта',
];

const check =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
---

<section id="product" class="pf-section pf-section--alt">
  <div class="pf-container">
    <div class="pf-head">
      <h2 class="pf-h2">Как это выглядит в&nbsp;работе</h2>
      <p class="pf-lead">
        Настоящий интерфейс по кусочку: живой ход задачи, проверки перед выкаткой, деньги
        проекта. Так это выглядит у тебя в приложении.
      </p>
    </div>

    <div class="sh-grid">
      <!-- Живой ход задачи -->
      <article class="sh">
        <div class="sh__text">
          <h3 class="sh__title">Видно каждый шаг</h3>
          <p class="sh__sub">Живой ход работы: что AI делает прямо сейчас и во что это обходится.</p>
        </div>
        <div class="sh__win" role="img" aria-label="Задача «Меню с ценами и фото»: AI выполнил три шага из четырёх, потрачено 3,20 ₽">
          <div class="sh__bar">
            <span class="pf-tag pf-tone-orange"><span class="pf-tag__text">Сайт кофейни</span></span>
            <span class="sh__crumb">Меню с ценами и фото</span>
            <span class="pf-tag pf-tone-queue sh__end"><span class="pf-tag__text">AI делает</span></span>
          </div>
          <ul class="sh__body live">
            {
              live.map((l) => (
                <li class:list={['live__row', !l.done && 'live__row--now']}>
                  {l.done ? <span class="live__ic live__ic--done" set:html={check} /> : <span class="live__ic live__ic--now" />}
                  {l.text}
                </li>
              ))
            }
          </ul>
          <div class="sh__foot live__foot">
            <span class="live__track"><span style="inline-size: 84%"></span></span>
            <span class="live__num">84%</span>
            <span class="live__num">3,20&nbsp;₽</span>
          </div>
        </div>
      </article>

      <!-- Автопроверки -->
      <article class="sh">
        <div class="sh__text">
          <h3 class="sh__title">Проверки перед выкаткой</h3>
          <p class="sh__sub">Сборка, линтер, секреты — всё зелёное, можно выкатывать.</p>
        </div>
        <div class="sh__win" role="img" aria-label="Автопроверки: четыре из четырёх пройдены, готово к выкатке">
          <div class="sh__bar">
            <span class="sh__crumb sh__crumb--strong">Автопроверки</span>
            <span class="pf-tag pf-tone-done sh__end"><span class="pf-tag__text">4 из 4</span></span>
          </div>
          <ul class="sh__body checks">
            {
              checks.map((c) => (
                <li class="checks__row">
                  <span class="live__ic live__ic--done" set:html={check} />
                  {c}
                </li>
              ))
            }
          </ul>
          <div class="sh__foot">
            <span class="pf-tag pf-tone-done"><span class="pf-tag__text">Готово к выкатке</span></span>
          </div>
        </div>
      </article>

      <!-- Деньги -->
      <article class="sh">
        <div class="sh__text">
          <h3 class="sh__title">Деньги с одного взгляда</h3>
          <p class="sh__sub">Доход, расходы и прибыль по проекту — в рублях.</p>
        </div>
        <div class="sh__win" role="img" aria-label="Финансы проекта: доход 214 000 ₽, расходы 85 600 ₽, прибыль 128 400 ₽, маржа 60%. Прибыль растёт с февраля по июль">
          <div class="sh__bar">
            <span class="pf-tag pf-tone-green"><span class="pf-tag__text">Бот записи</span></span>
            <span class="sh__crumb">Финансы</span>
          </div>
          <div class="sh__body money">
            {
              money.map((m) => (
                <div class="money__tile">
                  <span class="money__label">{m.label}</span>
                  <span class="money__value">{m.value}</span>
                  {m.note && <span class="money__note">{m.note}</span>}
                </div>
              ))
            }
          </div>
          <div class="sh__foot chart">
            <span class="chart__title">Прибыль по месяцам</span>
            <span class="chart__bars">
              {
                profit.map((p, i) => (
                  <span class="chart__col">
                    <span
                      class:list={['chart__bar', i === profit.length - 1 && 'chart__bar--now']}
                      style={`--h: ${Math.round((p.v / profitMax) * 100)}%`}
                    />
                    <span class="chart__m">{p.m}</span>
                  </span>
                ))
              }
            </span>
          </div>
        </div>
      </article>

      <!-- Строки расходов и доходов -->
      <article class="sh">
        <div class="sh__text">
          <h3 class="sh__title">Расходы и доходы&nbsp;— по строкам</h3>
          <p class="sh__sub">Каждая трата и оплата — с суммой, категорией и датой.</p>
        </div>
        <div class="sh__win" role="img" aria-label="Список операций за июль: оплаты клиентов, AI-бюджет, домен и хостинг, подписка">
          <div class="sh__bar">
            <span class="sh__crumb sh__crumb--strong">Операции</span>
            <span class="sh__crumb sh__end">Июль</span>
          </div>
          <ul class="sh__body ops">
            {
              rows.map((r) => (
                <li class="ops__row">
                  <span class="ops__title">{r.title}</span>
                  <span class="pf-tag pf-tone-gray ops__tag"><span class="pf-tag__text">{r.tag}</span></span>
                  <span class="ops__date">{r.date}</span>
                  <span class:list={['ops__sum', r.income && 'ops__sum--in']}>{r.sum}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>

    <div class="ask">
      <h3 class="pf-h3">Что можно поручить</h3>
      <p class="ask__note">Просто опиши задачу словами — остальное платформа берёт на себя.</p>
      <ul class="ask__list">
        {examples.map((e) => <li class="ask__item">«{e}»</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  /* Бенто 7/5 и 5/7. */
  .sh-grid {
    display: grid;
    gap: 2rem 1.5rem;
  }
  @media (min-width: 900px) {
    .sh-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .sh:nth-child(4n + 1),
    .sh:nth-child(4n + 4) { grid-column: span 7; }
    .sh:nth-child(4n + 2),
    .sh:nth-child(4n + 3) { grid-column: span 5; }
  }

  .sh {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sh__title {
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    color: oklch(var(--foreground));
  }
  .sh__sub {
    margin-block-start: 0.375rem;
    max-inline-size: 32rem;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: oklch(var(--muted-foreground));
  }

  /* Окно приложения: белый лист, шапка 40px с линией, плотное содержимое. */
  .sh__win {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    flex: 1;
    border-radius: var(--r-xl);
    background: oklch(var(--card));
    box-shadow: var(--shadow-card);
    overflow: clip;
  }
  .sh__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-inline-size: 0;
    min-block-size: 2.5rem;
    padding-inline: 0.875rem;
    border-block-end: 1px solid oklch(var(--border));
  }
  .sh__crumb {
    min-inline-size: 0;
    font-size: var(--text-ui);
    color: oklch(var(--muted-foreground));
    white-space: nowrap;
    overflow: clip;
    text-overflow: ellipsis;
  }
  .sh__crumb--strong { color: oklch(var(--foreground)); font-weight: 600; }
  .sh__end { margin-inline-start: auto; flex: none; }
  .sh__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0.875rem;
    list-style: none;
  }
  .sh__foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: auto;
    padding: 0.75rem 0.875rem;
    border-block-start: 1px solid oklch(var(--border));
  }

  /* Живой ход задачи. */
  .live__row,
  .checks__row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-sm);
    color: oklch(var(--muted-foreground));
  }
  .checks__row { color: oklch(var(--foreground)); }
  .live__row--now { color: oklch(var(--foreground)); font-weight: 500; }
  .live__ic {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 1.125rem;
    block-size: 1.125rem;
    border-radius: 50%;
  }
  .live__ic :global(svg) { inline-size: 0.6875rem; block-size: 0.6875rem; }
  .live__ic--done {
    background: var(--done-soft);
    color: oklch(var(--done-ink));
  }
  .live__ic--now::before {
    content: '';
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: oklch(var(--primary));
  }
  .live__track {
    flex: 1;
    block-size: 0.375rem;
    border-radius: var(--r-full);
    background: color-mix(in oklch, oklch(var(--primary)) 16%, transparent);
    overflow: clip;
  }
  .live__track span {
    display: block;
    block-size: 100%;
    border-radius: inherit;
    background: oklch(var(--primary));
  }
  .live__num {
    font-size: var(--text-ui);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: oklch(var(--foreground));
  }

  /* Деньги: три плитки. */
  .money {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: 0.5rem;
  }
  .money__tile {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--r-lg);
    background: oklch(var(--panel));
  }
  .money__label,
  .money__note {
    font-size: var(--text-meta);
    color: oklch(var(--muted-foreground));
  }
  .money__value {
    font-size: var(--text-h3);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    font-variant-numeric: tabular-nums;
    color: oklch(var(--foreground));
    white-space: nowrap;
  }

  /* Операции: строки с линиями. */
  .ops { gap: 0; padding-block: 0.25rem; }
  .ops__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    align-items: center;
    gap: 0.25rem 0.75rem;
    padding-block: 0.625rem;
  }
  .ops__row + .ops__row { border-block-start: 1px solid oklch(var(--border)); }
  .ops__title {
    min-inline-size: 0;
    font-size: var(--text-sm);
    color: oklch(var(--foreground));
    white-space: nowrap;
    overflow: clip;
    text-overflow: ellipsis;
  }
  .ops__date {
    font-size: var(--text-meta);
    color: oklch(var(--muted-foreground));
    white-space: nowrap;
  }
  .ops__sum {
    min-inline-size: 6.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: end;
    color: oklch(var(--foreground));
    white-space: nowrap;
  }
  .ops__sum--in { color: oklch(var(--done-ink)); }
  @media (prefers-color-scheme: dark) {
    .ops__sum--in { color: oklch(var(--done)); }
  }
  /* Узкое окно: дата под названием, метку категории прячем; прибыль — во всю ширину. */
  @container (width < 30rem) {
    .ops__row { grid-template-columns: minmax(0, 1fr) auto; }
    .ops__tag { display: none; }
    .ops__title { grid-column: 1; grid-row: 1; }
    .ops__date { grid-column: 1; grid-row: 2; }
    .ops__sum { grid-column: 2; grid-row: 1 / span 2; }
    .money { grid-template-columns: 1fr 1fr; }
    .money__tile:last-child { grid-column: 1 / -1; }
  }

  /* График прибыли: столбики по месяцам, текущий — синим. */
  .chart {
    flex-direction: column;
    align-items: stretch;
    gap: 0.625rem;
    padding-block: 0.875rem;
  }
  .chart__title {
    font-size: var(--text-ui);
    font-weight: 600;
    color: oklch(var(--foreground));
  }
  .chart__bars {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.5rem;
    block-size: 6.5rem;
  }
  .chart__col {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.375rem;
  }
  .chart__bar {
    align-self: end;
    block-size: var(--h);
    border-radius: 3px;
    background: color-mix(in oklch, oklch(var(--muted-foreground)) 24%, transparent);
  }
  .chart__bar--now { background: oklch(var(--primary)); }
  .chart__m {
    font-size: var(--text-xs);
    color: oklch(var(--muted-foreground));
    text-align: center;
  }

  /* Что можно поручить — список фраз, без карточек. */
  .ask {
    margin-block-start: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .ask__note {
    margin-block-start: 0.5rem;
    font-size: var(--text-md);
    color: oklch(var(--muted-foreground));
  }
  .ask__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0 2rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid oklch(var(--border));
  }
  .ask__item {
    padding-block: 0.875rem;
    padding-inline-end: 1rem;
    border-block-end: 1px solid oklch(var(--border));
    font-size: var(--text-base);
    font-weight: 500;
    color: oklch(var(--foreground));
  }
</style>
