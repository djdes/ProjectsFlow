---
import { PLANS, formatRub } from '@/data/pricing';

const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');
---

<!-- Тарифы — таблицей, как табло: тариф строкой, цена крупно, действие у правого края.
     Рекомендуемый выделен словом и главной кнопкой, не цветом строки. -->
<section id="pricing" class="pf-section pf-band--paper pricing" aria-labelledby="pricing-title">
  <div class="pf-container">
    <h2 id="pricing-title" class="pf-h2 pricing__title">Простые тарифы. Начни бесплатно.</h2>

    <div class="plans">
      <div class="plans__heads" aria-hidden="true">
        <span>Тариф</span>
        <span>Что внутри</span>
        <span>Цена</span>
      </div>
      {
        PLANS.map((plan) => (
          <article class:list={['plan', plan.highlight && 'plan--pop']} aria-labelledby={`plan-${plan.id}`}>
            <div class="plan__head">
              <div class="plan__title">
                <h3 class="plan__name" id={`plan-${plan.id}`}>{plan.name}</h3>
                {plan.badge && <span class="pf-pill plan__badge">{plan.badge}</span>}
              </div>
              <p class="plan__tagline">{plan.tagline}</p>
            </div>

            <ul class="plan__features">
              {plan.features.map((f) => <li>{f}</li>)}
            </ul>

            <p class="plan__price">
              <span class="plan__amount">{formatRub(plan.priceRub)}&nbsp;₽</span>
              <span class="plan__per">
                {plan.priceNote}
                {plan.priceUsd && <span> (${plan.priceUsd})</span>}
              </span>
            </p>

            <div class="plan__actions">
              <a
                href={`${appBase}${plan.href}`}
                class:list={['pf-btn', 'pf-btn--block', plan.highlight ? 'pf-btn--primary' : 'pf-btn--secondary']}
              >
                {plan.cta}
              </a>
              {plan.trialCta && (
                <button type="button" class="pf-btn pf-btn--block pf-btn--secondary">
                  {plan.trialCta}
                </button>
              )}
              {(plan.note || plan.requestOnly) && (
                <p class="plan__note">{plan.note ?? 'Подключаем вручную, не самостоятельно.'}</p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pricing { padding-block-end: var(--space-2xl); }
  .pricing__title { margin-block-end: var(--space-2xl); }

  /* Таблица тарифов: шапка над линией 2px, строки через тонкую линию. */
  .plans { border-block-start: var(--rule-bar) solid var(--color-ink); }
  .plans__heads { display: none; }
  .plan {
    display: grid;
    gap: var(--space-md);
    padding-block: var(--space-xl);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }
  .plan--pop { border-block-end: var(--rule-bar) solid var(--color-ink); }
  .plan:has(+ .plan--pop) { border-block-end: var(--rule-bar) solid var(--color-ink); }

  .plan__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
  }
  .plan__name {
    max-inline-size: none;
    font-size: var(--text-2xl);
  }
  .plan__badge { border-color: var(--color-accent); }
  .plan__tagline {
    margin-block-start: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .plan__features {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .plan__features li {
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: baseline;
  }
  .plan__features li::before {
    content: '';
    inline-size: 0.5rem;
    block-size: 0.5rem;
    background: var(--color-ink);
  }
  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-xs);
  }
  .plan__amount {
    font-size: var(--text-display-s);
    font-stretch: var(--stretch-display);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    white-space: nowrap;
  }
  .plan__per {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .plan__actions {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }
  .plan__note {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  @media (min-width: 40rem) and (max-width: 79.99rem) {
    .plan { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gap-columns); }
  }

  /* Четыре столбца — только там, где самая длинная кнопка помещается в свой. Цена и
     действия — фиксированные дорожки: столбцы совпадают во всех строках таблицы
     (у max-content каждая строка посчитала бы свои). */
  @media (min-width: 80rem) {
    .plans__heads,
    .plan {
      grid-template-columns: minmax(0, 3fr) minmax(0, 3.5fr) 15rem 20.5rem;
      column-gap: var(--gap-columns);
    }
    .plans__heads {
      display: grid;
      padding-block: var(--space-sm);
      border-block-end: var(--rule-hair) solid var(--color-rule);
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-muted);
    }
    .plan { align-items: start; }
  }
</style>
