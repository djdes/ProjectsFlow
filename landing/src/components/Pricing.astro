---
import { PLANS, formatRub } from '@/data/pricing';

const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');
---

<section id="pricing" class="pf-section">
  <div class="pf-container">
    <div class="pf-head">
      <h2 class="pf-h2">Простые тарифы&nbsp;— начни бесплатно</h2>
      <p class="pf-lead">
        На бесплатном — подключаешь свою подписку Claude. На Прайме и VIP — Claude работает
        онлайн от нас, ключи не нужны. Не зашло — вернём деньги.
      </p>
    </div>

    <div class="plans">
      {
        PLANS.map((plan) => (
          <article class:list={['plan', plan.highlight && 'plan--pop']} aria-labelledby={`plan-${plan.id}`}>
            <div class="plan__head">
              <h3 class="plan__name" id={`plan-${plan.id}`}>
                {plan.name}
                {plan.badge && (
                  <span class="pf-tag pf-tone-queue plan__badge">
                    <span class="pf-tag__text">{plan.badge}</span>
                  </span>
                )}
              </h3>
              <p class="plan__tagline">{plan.tagline}</p>
            </div>

            <p class="plan__price">
              <span class="plan__amount">{formatRub(plan.priceRub)}&nbsp;₽</span>
              <span class="plan__per">
                {plan.priceNote}
                {plan.priceUsd && <span> (${plan.priceUsd})</span>}
              </span>
            </p>

            <div class="plan__actions">
              <a
                href={`${appBase}${plan.href}`}
                class:list={['pf-btn', 'pf-btn--block', plan.highlight ? 'pf-btn--primary' : 'pf-btn--secondary']}
              >
                {plan.cta}
              </a>
              {plan.trialCta && (
                <button type="button" class="pf-btn pf-btn--block pf-btn--secondary">
                  {plan.trialCta}
                </button>
              )}
            </div>

            <ul class="pf-checks plan__features">
              {plan.features.map((f) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            {(plan.note || plan.requestOnly) && (
              <p class="plan__note">{plan.note ?? 'Подключаем вручную, не самостоятельно.'}</p>
            )}
          </article>
        ))
      }
    </div>

    <p class="plans__guarantee">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>Гарантия возврата на платных тарифах: <strong>не подошло — вернём деньги</strong>.</span>
    </p>
  </div>
</section>

<style>
  /* Карточки тарифов делят строки сетки (subgrid): кнопки и списки на одной высоте. */
  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem 1.25rem;
  }
  .plan {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 1.25rem;
    align-content: start;
    padding: 1.5rem;
    border-radius: var(--r-2xl);
    background: oklch(var(--card));
    box-shadow: var(--shadow-card);
  }
  /* Рекомендуемый — синее кольцо 2px вместо тени-кольца; без свечений и подъёма. */
  .plan--pop {
    box-shadow:
      0 0 0 2px oklch(var(--primary)),
      0 1px 3px oklch(16.84% 0 none / 0.06);
  }

  .plan__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-lead);
    font-weight: 700;
    line-height: var(--leading-snug);
    color: oklch(var(--foreground));
  }
  .plan__tagline {
    margin-block-start: 0.375rem;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: oklch(var(--muted-foreground));
  }
  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }
  .plan__amount {
    font-size: clamp(2rem, 1.75rem + 1vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
    color: oklch(var(--foreground));
  }
  .plan__per {
    font-size: var(--text-sm);
    color: oklch(var(--muted-foreground));
  }
  .plan__actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .plan__features {
    font-size: var(--text-md);
    color: oklch(var(--foreground));
  }
  .plan__note {
    font-size: var(--text-sm);
    color: oklch(var(--muted-foreground));
  }

  .plans__guarantee {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-block-start: 1.75rem;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: oklch(var(--muted-foreground));
  }
  .plans__guarantee strong { font-weight: 600; color: oklch(var(--foreground)); }
  .plans__guarantee svg {
    flex: none;
    inline-size: 1.125rem;
    block-size: 1lh;
  }
</style>
