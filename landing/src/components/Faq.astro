---
import { FAQ } from '@/data/faq';
---

<!-- Вопросы строками: голова слева, строки справа; ответ раскрывается под вопросом. -->
<section id="faq" class="pf-section pf-section--m" aria-labelledby="faq-title">
  <div class="pf-container faq">
    <div class="faq__head">
      <h2 id="faq-title" class="pf-h2">Частые вопросы</h2>
      <p class="pf-lead">Коротко и честно, без мелкого шрифта.</p>
    </div>

    <div class="faq__list">
      {
        FAQ.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span class="faq__q-text">{item.q}</span>
              <span class="faq__mark" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: var(--space-2xl) var(--gap-columns);
  }
  @media (min-width: 60rem) {
    .faq { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); align-items: start; }
  }
  .faq__head { display: grid; gap: var(--space-md); }

  .faq__list { border-block-start: var(--rule-bar) solid var(--color-ink); }
  .faq__item { border-block-end: var(--rule-hair) solid var(--color-rule); }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-block-size: 72px;
    padding-block: var(--space-md);
    list-style: none;
    cursor: pointer;
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    transition: color var(--dur-micro) steps(1);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:focus-visible { outline-offset: -2px; }
  @media (hover: hover) and (pointer: fine) {
    .faq__q:hover { color: var(--color-accent); }
  }

  /* Знак в квадратной клетке: «+» закрыт, «−» открыт. */
  .faq__mark {
    position: relative;
    flex: none;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border: var(--rule-bar) solid currentColor;
  }
  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    inline-size: 0.875rem;
    block-size: 2px;
    background: currentColor;
    translate: -50% -50%;
  }
  .faq__mark::after { rotate: 90deg; }
  .faq__item[open] .faq__mark { background: var(--color-ink); color: var(--color-paper); }
  .faq__item[open] .faq__mark::before { background: var(--color-paper); }
  .faq__item[open] .faq__mark::after { display: none; }

  /* Ответ открывается сразу, без анимации высоты: Wayfind меняет состояние рывком, как табло. */
  .faq__a { padding-block-end: var(--space-lg); }
  .faq__a p {
    max-inline-size: 60ch;
    color: var(--color-ink-2);
  }
</style>
