---
import { FAQ } from '@/data/faq';
import { nbspDash } from '@/lib/typo';
---

<section id="faq" class="pf-section">
  <div class="pf-container faq">
    <div class="pf-head faq__head">
      <h2 class="pf-h2">Частые вопросы</h2>
      <p class="pf-lead">Коротко и честно — без мелкого шрифта.</p>
    </div>

    <div class="faq__list">
      {
        FAQ.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              <svg class="faq__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{nbspDash(item.q)}</span>
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Заголовок слева, вопросы справа — как страница-справка в Notion. */
  .faq {
    display: grid;
    gap: 0 3rem;
  }
  @media (min-width: 960px) {
    .faq { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); align-items: start; }
    .faq__head { position: sticky; inset-block-start: calc(var(--nav-h) + 2rem); }
  }

  .faq__list { border-block-start: 1px solid oklch(var(--border)); }
  .faq__item { border-block-end: 1px solid oklch(var(--border)); }

  .faq__q {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 1rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: var(--r-md);
    list-style: none;
    cursor: pointer;
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: oklch(var(--foreground));
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:active { background: var(--active); }
  @media (hover: hover) and (pointer: fine) {
    .faq__q:hover { background: var(--hover); }
  }
  .faq__chev {
    flex: none;
    inline-size: 1.125rem;
    block-size: 1lh;
    color: oklch(var(--muted-foreground));
  }
  .faq__item[open] .faq__chev { rotate: 90deg; }
  @media (prefers-reduced-motion: no-preference) {
    .faq__chev { transition: rotate var(--dur) var(--ease-out); }
  }

  /* Раскрытие по высоте — там, где браузер это умеет; иначе просто открывается. */
  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
  }
  .faq__item[open]::details-content { block-size: auto; }
  @media (prefers-reduced-motion: no-preference) {
    .faq__item::details-content {
      transition:
        block-size var(--dur) var(--ease-out),
        content-visibility var(--dur) allow-discrete;
    }
  }
  .faq__a {
    padding: 0 0 1.25rem 1.75rem;
  }
  .faq__a p {
    max-inline-size: 60ch;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: oklch(var(--muted-foreground));
  }
</style>
