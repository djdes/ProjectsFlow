---
// Финальный призыв: одна главная кнопка + вариант «Открыть приложение» для вошедших.
// Пути относительные — лендинг и SPA отдаются одним Express'ом; PUBLIC_APP_URL — только для dev.
const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');
---

<section class="pf-section cta" aria-labelledby="cta-title">
  <div class="pf-container">
    <div class="cta__panel">
      <div class="cta__text">
        <h2 id="cta-title" class="pf-h2">Преврати идею в продукт уже сегодня</h2>
        <p class="cta__sub">
          Опиши, что хочешь получить, — остальное платформа берёт на себя. Бесплатно и без
          карты, а на Прайм переходишь, только если зашло.
        </p>
      </div>
      <div class="cta__actions">
        <a href={`${appBase}/register`} data-auth-anon class="pf-btn pf-btn--primary pf-btn--lg">Начать бесплатно</a>
        <a href={`${appBase}/`} data-auth-authed class="pf-btn pf-btn--primary pf-btn--lg">Открыть приложение</a>
        <p class="cta__fine">Без карты. Не зашло — вернём деньги. Проект остаётся твоим.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta__panel {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: center;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-radius: var(--r-2xl);
    background: oklch(var(--panel));
  }
  @media (min-width: 900px) {
    .cta__panel { grid-template-columns: minmax(0, 1fr) auto; }
  }
  @media (prefers-color-scheme: dark) {
    .cta__panel { box-shadow: var(--shadow-card); }
  }
  .cta__sub {
    max-inline-size: var(--measure);
    margin-block-start: 0.875rem;
    font-size: var(--text-lead);
    line-height: var(--leading-body);
    color: oklch(var(--muted-foreground));
  }
  .cta__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
  }
  .cta__fine {
    max-inline-size: 22rem;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: oklch(var(--muted-foreground));
  }
</style>
