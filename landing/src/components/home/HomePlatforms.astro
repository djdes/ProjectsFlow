---
// «Где работает»: веер из пяти карточек платформ (как у fluidvoice). Веер раскрывается, когда
// въезжает в экран (.fan.is-in ставит scripts/home-motion.ts); без JS и при reduced motion он
// раскрыт сразу. Крупная иконка видна на верхней (правой) карточке, у остальных её закрывает соседка.
import { PLATFORMS, type PlatformId } from '@/data/home';
import Words from './Words.astro';

const icon: Record<PlatformId, string> = {
  browser:
    '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path>',
  iphone: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"></rect><path d="M11 18.5h2"></path>',
  telegram: '<path d="M21 4L3 11l6.5 2.5L12 20l3-5.5L21 4z"></path><path d="M9.5 13.5L21 4"></path>',
  mcp: '<rect x="3" y="4.5" width="18" height="15" rx="2.5"></rect><path d="M7 9.5l3 2.5-3 2.5M12.5 15h4.5"></path>',
  github:
    '<circle cx="6" cy="5.5" r="2"></circle><circle cx="6" cy="18.5" r="2"></circle><circle cx="18" cy="8" r="2"></circle><path d="M6 7.5v9M18 10c0 4.5-6 4-11 7"></path>',
};
const middle = (PLATFORMS.length - 1) / 2;
---

<section id="platforms" class="section platforms" aria-labelledby="platforms-title">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <p class="eyebrow rb">Где работает</p>
      <h2 id="platforms-title" class="h2 rw"><Words parts={[{ text: 'Работает там,' }, { text: 'где тебе удобно.', dim: true }]} /></h2>
      <p class="sub rb" style="--d:120ms">Браузер, iPhone, Telegram, Claude Code и GitHub: один проект везде.</p>
    </div>
    <div class="fan-stage">
      <div class="halo fan__glow" aria-hidden="true"></div>
      <ul class="fan" aria-label="Где работает ProjectsFlow">
        {
          PLATFORMS.map((p, i) => (
            <li class="pcard" style={`--k:${i - middle}`}>
              <svg class="ico pcard__ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icon[p.id]} />
              <p class="pcard__t">{p.title}</p>
              <p class="pcard__n">{p.note}</p>
              <svg class="ico pcard__big" viewBox="0 0 24 24" aria-hidden="true" set:html={icon[p.id]} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
