---
// Главная фраза: лист с закруглённым верхом наезжает на первый экран, слова загораются по одному
// по мере прокрутки (scripts/home-motion.ts). Факты — в полосе внизу первого экрана (HomeHero).
import { STATEMENT } from '@/data/home';

const words = STATEMENT.split(' ');
---

<section class="statement sheet rv" aria-label="Чем ProjectsFlow отличается от трекера задач">
  <div class="statement__glow" aria-hidden="true"></div>
  <div class="wrap statement__in">
    <p class="eyebrow">В двух словах</p>
    <p class="statement__text">
      {words.map((word, i) => (
        <>
          <span class="lw">{word}</span>
          {i < words.length - 1 ? ' ' : ''}
        </>
      ))}
    </p>
  </div>
</section>
