---
// «Как это работает»: заголовок слева стоит, четыре шага ложатся стопкой (--c у .step).
import { STEPS } from '@/data/home';
import HomeArrow from './HomeArrow.astro';
import Words from './Words.astro';

interface Props {
  appBase: string;
}
const { appBase } = Astro.props;
const check = 'M5 12.5l4.2 4.2L19 7';
---

<section id="how" class="section how rv" aria-labelledby="how-title">
  <div class="wrap how__grid">
    <div class="how__side">
      <div class="how__sticky">
        <p class="eyebrow rb">Как это работает</p>
        <h2 id="how-title" class="h2 rw"><Words parts={[{ text: 'От идеи до готового' }, { text: 'за четыре шага.', dim: true }]} /></h2>
        <p class="sub rb" style="--d:120ms">
          Без настройки серверов и возни с ключами. Ты ставишь задачи и принимаешь работу, остальное делает платформа.
        </p>
        <a class="btn btn--solid rb" style="--d:200ms" href={`${appBase}/register`} data-auth-anon>Попробовать бесплатно<span class="btn__ic" aria-hidden="true"><HomeArrow /></span></a>
        <a class="btn btn--solid rb" style="--d:200ms" href={`${appBase}/`} data-auth-authed>Открыть приложение<span class="btn__ic" aria-hidden="true"><HomeArrow /></span></a>
      </div>
    </div>
    <ol class="steps">
      {
        STEPS.map((step, i) => (
          <li class="step">
            <div class="step__txt rb">
              <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{step.title}</h3>
              <p>{step.text}</p>
            </div>
            <div class="step__vis rb" style="--d:120ms" aria-hidden="true">
              {step.id === 'idea' && (
                <>
                  <div class="prompt">
                    <span class="prompt__t">
                      Хочу магазин в Telegram с оплатой по СБП<span class="caret" />
                    </span>
                    <span class="prompt__go"><svg class="ico ico--sm" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
                  </div>
                  <div class="tags">
                    <span class="tag">Каталог</span>
                    <span class="tag">Корзина</span>
                    <span class="tag">Оплата по СБП</span>
                    <span class="tag">Уведомления</span>
                  </div>
                </>
              )}
              {step.id === 'workers' &&
                [
                  ['Каталог и корзина', 'пишет код'],
                  ['Оплата по СБП', 'гоняет тесты'],
                ].map(([task, action]) => (
                  <div class="wk">
                    <span class="wk__av"><svg class="ico ico--sm" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="15" rx="2.5" /><path d="M7 9.5l3 2.5-3 2.5M12.5 15h4.5" /></svg></span>
                    <span class="wk__t">{task}<small>{action}</small></span>
                    <span class="dot dot--live dot--sm" />
                  </div>
                ))}
              {step.id === 'checks' && (
                <div class="checks">
                  {['Сборка и типы', 'Защита оплаты', 'Мобильный вид', 'Живой стенд'].map((name) => (
                    <span class="ck"><svg class="ico ico--sm" viewBox="0 0 24 24"><path d={check} /></svg>{name}</span>
                  ))}
                </div>
              )}
              {step.id === 'accept' && (
                <>
                  <div class="stand">
                    <svg class="ico ico--sm" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
                    <span>Живой стенд готов</span>
                    <span class="stand__ok">открыт</span>
                  </div>
                  <div class="approve">
                    <span class="btn btn--solid btn--sm">Принять работу</span>
                    <span class="btn btn--line btn--sm">Доработать</span>
                  </div>
                </>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
