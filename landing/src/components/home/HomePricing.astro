---
// Тарифы одной карточкой (как у fluidvoice): три колонки с разделителями, радужная линия по
// верхнему краю. Данные — data/pricing.ts, гарантии — data/home.ts. Вошедшему вместо регистрации —
// «Открыть приложение»: страницы выбора тарифа в приложении нет.
import { GUARANTEES } from '@/data/home';
import { PLANS, formatRub } from '@/data/pricing';
import HomeArrow from './HomeArrow.astro';
import Words from './Words.astro';

interface Props {
  appBase: string;
}
const { appBase } = Astro.props;

const capitalize = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);

const guaranteeIcon: Record<(typeof GUARANTEES)[number]['id'], string> = {
  trial: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7.5V12l3 2"></path>',
  refund: '<path d="M4 4v5h5"></path><path d="M5.6 15a7.5 7.5 0 1 0 1.6-7.8L4 9"></path>',
  help: '<circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="3.5"></circle><path d="M5.6 5.6l3.9 3.9M14.5 14.5l3.9 3.9M18.4 5.6l-3.9 3.9M9.5 14.5l-3.9 3.9"></path>',
  nolockin: '<rect x="4.5" y="10.5" width="15" height="10" rx="2.5"></rect><path d="M8 10.5V7.5a4 4 0 0 1 7.6-1.7"></path>',
};
---

<section id="pricing" class="section" aria-labelledby="pricing-title">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <p class="eyebrow rb">Тарифы</p>
      <h2 id="pricing-title" class="h2 rw"><Words parts={[{ text: 'Простые тарифы.' }, { text: 'Старт бесплатно.', dim: true }]} /></h2>
      <p class="sub rb" style="--d:120ms">Цены в рублях. Платный тариф не подошёл, вернём деньги.</p>
    </div>
    <div class="plans">
      {
        PLANS.map((plan, i) => (
          <article class:list={['plan', 'rb', { 'plan--hi': plan.highlight }]} style={`--d:${i * 120}ms`}>
            <div class="plan__top">
              <h3 class="plan__name">{plan.name}</h3>
              {plan.badge && <span class="badge">{plan.badge}</span>}
              {plan.requestOnly && <span class="badge badge--muted">По запросу</span>}
            </div>
            <p class="plan__price">
              <span class="plan__num">{formatRub(plan.priceRub)}&nbsp;₽</span>
              <span class="plan__per">{plan.priceNote}</span>
            </p>
            <p class="plan__tag">{plan.tagline}</p>
            <ul class="plan__list">
              {plan.features.map((feature) => (
                <li>{capitalize(feature)}</li>
              ))}
            </ul>
            <div class="plan__cta">
              <a class:list={['btn', plan.highlight ? 'btn--solid' : 'btn--line']} href={`${appBase}${plan.href}`} data-auth-anon>
                {plan.cta}
                <span class="btn__ic" aria-hidden="true"><HomeArrow /></span>
              </a>
              <a class:list={['btn', plan.highlight ? 'btn--solid' : 'btn--line']} href={`${appBase}/`} data-auth-authed>
                Открыть приложение
                <span class="btn__ic" aria-hidden="true"><HomeArrow /></span>
              </a>
              {plan.trialCta && (
                <a class="plan__trial" href={`${appBase}${plan.href}`} data-auth-anon>
                  {plan.trialCta}
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
    <ul class="guar" aria-label="Гарантии">
      {
        GUARANTEES.map((g, i) => (
          <li class="rb" style={`--d:${i * 80}ms`}>
            <span class="guar__ic"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={guaranteeIcon[g.id]} /></span>
            <div>
              <p class="guar__h">{g.title}</p>
              <p class="guar__t">{g.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
