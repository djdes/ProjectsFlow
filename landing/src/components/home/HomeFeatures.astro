---
// «Больше, чем доска»: две большие карточки — LIVE-лента и Автопилот.
import { BIG_FEATURES } from '@/data/home';
import Words from './Words.astro';
---

<section id="features" class="section" aria-labelledby="features-title">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow rb">Внутри</p>
      <h2 id="features-title" class="h2 rw"><Words parts={[{ text: 'Больше, чем доска' }, { text: 'с задачами.', dim: true }]} /></h2>
    </div>
    <div class="duo">
      {
        BIG_FEATURES.map((feature, i) => (
          <article class="big rb" style={`--d:${i * 120}ms`}>
            <div class="big__vis" aria-hidden="true">
              {feature.id === 'live' && (
                <div class="thread">
                  <div class="msg msg--me">
                    <span class="msg__who">Ты</span>Сделай кнопку «Купить» заметнее и добавь оплату по СБП
                  </div>
                  <div class="tev">
                    <svg class="ico ico--sm" viewBox="0 0 24 24"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" /><circle cx="12" cy="12" r="2.8" /></svg>
                    Воркер взял задачу
                  </div>
                  <div class="tev">
                    <svg class="ico ico--sm" viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M13.5 6.5l4 4" /></svg>
                    <span>Правит <code>checkout.ts</code> и ещё 3 файла</span>
                  </div>
                  <div class="tev tev--ok">
                    <svg class="ico ico--sm" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7" /></svg>
                    Проверки прошли, стенд обновлён
                  </div>
                  <div class="msg msg--bot">
                    <span class="msg__who">Воркер</span>Готово. Посмотри стенд и прими работу, если всё так.
                  </div>
                </div>
              )}
              {feature.id === 'autopilot' && (
                <>
                  <div class="orbit"><i /></div>
                  <div class="auto">
                    <div class="auto__row">
                      <div class="auto__goal"><small>Цель проекта</small><b>Запустить магазин в Telegram</b></div>
                    </div>
                    <div class="auto__row">
                      <span class="auto__lbl">
                        <svg class="ico" viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" /><path d="M19 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2z" /></svg>
                        Автопилот
                      </span>
                      <span class="tgl"><i /></span>
                    </div>
                    <ul class="steps-mini">
                      <li class="sm sm--done"><span class="sm__ic"><svg class="ico ico--sm" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7" /></svg></span>Каталог и корзина</li>
                      <li class="sm sm--done"><span class="sm__ic"><svg class="ico ico--sm" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7" /></svg></span>Оплата по СБП</li>
                      <li class="sm sm--now"><span class="sm__ic"><span class="spin" /></span>Тексты для витрины</li>
                      <li class="sm"><span class="sm__ic" />Уведомления о заказах</li>
                    </ul>
                  </div>
                </>
              )}
            </div>
            <div class="big__txt">
              <h3 class="h3">{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
