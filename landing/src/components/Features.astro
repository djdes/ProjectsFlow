---
import { FEATURES, SECONDARY_FEATURES } from '@/data/features';
import { nbspDash } from '@/lib/typo';

// Line-иконки (24×24) для второго ряда возможностей.
const ICONS: Record<string, string> = {
  team: 'M16 20v-1a4 4 0 00-4-4H7a4 4 0 00-4 4v1M9.5 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM21 20v-1a4 4 0 00-3-3.9M16 4.1a4 4 0 010 7.8',
  telegram: 'M21 4L3 11l6 2.5L11 20l3-4 4 3z',
  monitoring: 'M3 12h4l2 6 4-12 2 6h6',
  finance: 'M3 7h15a1 1 0 011 1v9a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1h12M16 12h3',
  hub: 'M12 8a2 2 0 100-4 2 2 0 000 4zM5 20a2 2 0 100-4 2 2 0 000 4zM19 20a2 2 0 100-4 2 2 0 000 4zM12 6v4M12 10l-5 6M12 10l5 6',
  live: 'M12 8v4l3 2M12 3a9 9 0 100 18 9 9 0 000-18z',
};

// Расход по месяцам для мини-графика (доля от максимума).
const spend = [42, 66, 51, 78, 60, 88];
---

<section id="features" class="pf-section pf-section--alt">
  <div class="pf-container">
    <div class="pf-head">
      <h2 class="pf-h2">Меньше рутины&nbsp;— больше готового</h2>
      <p class="pf-lead">
        Идеи, работа над ними и деньги — в одном месте. Ты задаёшь направление, платформа
        доводит до результата. Без разброса по чатам и десятку вкладок.
      </p>
    </div>

    <div class="ft-grid">
      {
        FEATURES.map((f) => (
          <article class={`ft ft--${f.icon}`}>
            <div class="ft__text">
              <h3 class="ft__title">{nbspDash(f.title)}</h3>
              <p class="ft__body">{f.body}</p>
            </div>

            {/* Фрагмент настоящего интерфейса под смысл возможности. */}
            <div class="ft__ui" aria-hidden="true">
              {f.icon === 'idea' && (
                <>
                  <div class="ui-composer">
                    <span class="ui-composer__text">Собери лендинг для запуска</span>
                    <span class="ui-composer__send">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
                    </span>
                  </div>
                  <div class="ui-card">
                    <span class="ui-card__title">Собрать лендинг для запуска</span>
                    <span class="ui-card__note">Hero, тарифы, форма заявки — по описанию</span>
                    <span class="ui-card__meta">
                      <span class="pf-tag pf-tone-done"><span class="pf-tag__text">Готово</span></span>
                      <span class="ui-muted">за 14 минут</span>
                    </span>
                  </div>
                </>
              )}

              {f.icon === 'autopilot' && (
                <div class="ui-card ui-pilot">
                  <span class="ui-pilot__head">
                    <span class="ui-card__title">Автопилот</span>
                    <span class="ui-switch"><span></span></span>
                  </span>
                  <ul class="ui-steps">
                    <li class="ui-step">
                      <span class="ui-step__ic ui-step__ic--done">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      </span>
                      Настроил проверку сборки
                    </li>
                    <li class="ui-step">
                      <span class="ui-step__ic ui-step__ic--done">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                      </span>
                      Починил формы на телефоне
                    </li>
                    <li class="ui-step ui-step--now">
                      <span class="ui-step__ic ui-step__ic--run"></span>
                      Пишет тесты оплаты
                      <span class="ui-run">AI делает</span>
                    </li>
                  </ul>
                </div>
              )}

              {f.icon === 'cost' && (
                <div class="ui-card ui-cost">
                  <span class="ui-cost__head">
                    <span class="ui-muted">Расход за проект</span>
                    <span class="ui-cost__sum">1 240&nbsp;₽</span>
                  </span>
                  <span class="ui-bars">
                    {spend.map((h, i) => (
                      <span class:list={['ui-bar', i === spend.length - 1 && 'ui-bar--now']} style={`--h: ${h}%`} />
                    ))}
                  </span>
                  <span class="ui-cost__foot">
                    <span class="ui-muted">Январь — июнь</span>
                    <span class="ui-muted">≈ 38&nbsp;₽ за задачу</span>
                  </span>
                </div>
              )}

              {f.icon === 'claude' && (
                <div class="ui-card ui-plans">
                  <span class="ui-plan">
                    <span class="ui-plan__name">Claude от ProjectsFlow</span>
                    <span class="pf-tag pf-tone-blue"><span class="pf-tag__text">Прайм</span></span>
                    <span class="ui-online">онлайн</span>
                  </span>
                  <span class="ui-plan">
                    <span class="ui-plan__name">Claude для команды</span>
                    <span class="pf-tag pf-tone-brown"><span class="pf-tag__text">VIP</span></span>
                    <span class="ui-online">онлайн</span>
                  </span>
                  <span class="ui-plan">
                    <span class="ui-plan__name">Своя подписка Claude</span>
                    <span class="pf-tag pf-tone-gray"><span class="pf-tag__text">Бесплатный</span></span>
                    <span class="ui-muted">подключить</span>
                  </span>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <div class="ft-more">
      <h3 class="pf-h3">Ещё в ProjectsFlow</h3>
      <ul class="ft-more__list">
        {
          SECONDARY_FEATURES.map((f) => (
            <li class="ft-more__item">
              <svg class="ft-more__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d={ICONS[f.icon]} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <p class="ft-more__title">{nbspDash(f.title)}</p>
              <p class="ft-more__body">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Плитки разной ширины: 7/5, затем 5/7 — не четыре одинаковые карточки. */
  .ft-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .ft-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.25rem; }
    .ft:nth-child(4n + 1),
    .ft:nth-child(4n + 4) { grid-column: span 7; }
    .ft:nth-child(4n + 2),
    .ft:nth-child(4n + 3) { grid-column: span 5; }
  }

  .ft {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--r-2xl);
    background: oklch(var(--card));
    box-shadow: var(--shadow-card);
  }
  .ft__text { max-inline-size: 32rem; }
  .ft__title {
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    color: oklch(var(--foreground));
  }
  .ft__body {
    margin-block-start: 0.5rem;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: oklch(var(--muted-foreground));
  }

  /* Фрагмент интерфейса: серая подложка колонки + белые карточки, как в приложении. */
  .ft__ui {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    margin-block-start: auto;
    min-block-size: 9.5rem;
    padding: 0.75rem;
    border-radius: var(--r-xl);
    background: oklch(var(--panel));
  }
  .ui-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 7px 10px;
    border-radius: var(--r-lg);
    background: oklch(var(--card));
    box-shadow: var(--shadow-card);
  }
  .ui-card__title {
    font-size: var(--text-card);
    font-weight: 600;
    line-height: 1.3;
    color: oklch(var(--foreground));
  }
  .ui-card__note,
  .ui-muted {
    font-size: var(--text-meta);
    line-height: var(--leading-snug);
    color: oklch(var(--muted-foreground));
  }
  .ui-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-block-start: 0.25rem;
  }

  /* Композер: задача словами. */
  .ui-composer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.5rem;
    padding: 0.375rem 0.375rem 0.375rem 0.75rem;
    border-radius: var(--r-lg);
    background: oklch(var(--field));
    box-shadow: var(--shadow-card);
  }
  .ui-composer__text {
    flex: 1;
    min-inline-size: 0;
    font-size: var(--text-sm);
    color: oklch(var(--foreground));
    white-space: nowrap;
    overflow: clip;
    text-overflow: ellipsis;
  }
  .ui-composer__send {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: var(--r-md);
    background: oklch(var(--primary-fill));
    color: oklch(var(--primary-foreground));
  }
  .ui-composer__send svg { inline-size: 0.875rem; block-size: 0.875rem; }

  /* Автопилот: переключатель + шаги. */
  .ui-pilot { gap: 0.5rem; padding-block: 0.625rem; }
  .ui-pilot__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .ui-switch {
    display: inline-flex;
    justify-content: flex-end;
    inline-size: 1.75rem;
    block-size: 1rem;
    padding: 2px;
    border-radius: var(--r-full);
    background: oklch(var(--primary));
  }
  .ui-switch span {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: 50%;
    background: oklch(100% 0 none);
  }
  .ui-steps {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ui-step {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    font-size: var(--text-ui);
    color: oklch(var(--muted-foreground));
  }
  .ui-step--now { color: oklch(var(--foreground)); font-weight: 500; }
  .ui-step__ic {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 1rem;
    block-size: 1rem;
    border-radius: 50%;
  }
  .ui-step__ic svg { inline-size: 0.625rem; block-size: 0.625rem; }
  .ui-step__ic--done {
    background: var(--done-soft);
    color: oklch(var(--done-ink));
  }
  .ui-step__ic--run::before {
    content: '';
    inline-size: 0.4375rem;
    block-size: 0.4375rem;
    border-radius: 50%;
    background: oklch(var(--primary));
  }
  .ui-run {
    font-size: var(--text-xs);
    font-weight: 500;
    color: oklch(var(--primary-ink));
  }

  /* Расход: сумма + столбики по месяцам, текущий — синим. */
  .ui-cost { gap: 0.5rem; padding-block: 0.625rem; }
  .ui-cost__head,
  .ui-cost__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .ui-cost__sum {
    font-size: var(--text-h3);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    font-variant-numeric: tabular-nums;
    color: oklch(var(--foreground));
  }
  .ui-bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    block-size: 3rem;
  }
  .ui-bar {
    flex: 1;
    block-size: var(--h);
    border-radius: 3px;
    background: color-mix(in oklch, oklch(var(--muted-foreground)) 24%, transparent);
  }
  .ui-bar--now { background: oklch(var(--primary)); }

  /* Подписки: от нас — онлайн, своя — подключаешь. */
  .ui-plans { gap: 0; padding-block: 0.25rem; }
  .ui-plan {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    padding-block: 0.5rem;
  }
  .ui-plan + .ui-plan { border-block-start: 1px solid oklch(var(--border)); }
  .ui-plan__name {
    flex: 1 1 10rem;
    min-inline-size: 0;
    font-size: var(--text-card);
    font-weight: 600;
    color: oklch(var(--foreground));
  }
  .ui-online {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    font-size: var(--text-meta);
    color: oklch(var(--muted-foreground));
  }
  .ui-online::before {
    content: '';
    inline-size: 0.4375rem;
    block-size: 0.4375rem;
    border-radius: 50%;
    background: oklch(var(--done));
  }

  /* Второй ряд — список без карточек: иконка, название, одна строка пользы. */
  .ft-more {
    margin-block-start: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .ft-more__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.75rem 2.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .ft-more__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    align-items: start;
  }
  .ft-more__ic {
    grid-row: span 2;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-block-start: 0.125rem;
    color: oklch(var(--muted-foreground));
  }
  .ft-more__title {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: oklch(var(--foreground));
  }
  .ft-more__body {
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: oklch(var(--muted-foreground));
  }
</style>
