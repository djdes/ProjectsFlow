---
import { FEATURES, SECONDARY_FEATURES } from '@/data/features';
import Screenshots from './Screenshots.astro';

// Переключатель: четыре возможности, у каждой — окна приложения, где её видно. Без JS
// вкладки скрыты и все четыре панели идут подряд; с JS видна одна, стрелки листают.
const PANELS = [
  {
    key: 'idea',
    tab: 'Задача',
    views: ['idea', 'live'],
    caption: 'Видно каждый шаг: что AI делает прямо сейчас и во что это обходится.',
  },
  {
    key: 'autopilot',
    tab: 'Автопилот',
    views: ['autopilot', 'checks'],
    caption: 'Проверки перед выкаткой: сборка, линтер, секреты. Всё зелёное, можно выкатывать.',
  },
  {
    key: 'cost',
    tab: 'Деньги',
    views: ['money', 'ops'],
    caption: 'Доход, расходы и прибыль по проекту в рублях. Каждая трата и оплата с суммой, категорией и датой.',
  },
  {
    key: 'claude',
    tab: 'Claude',
    views: ['plans'],
    caption: 'Онлайн-доступ к ведущим LLM. Без VPN и без своих API-ключей.',
  },
] as const;

const featureOf = (key: string) => FEATURES.find((f) => f.icon === key)!;
// Финансы и живой прогресс уже показаны во вкладках — в ряду их не повторяем.
const more = SECONDARY_FEATURES.filter((f) => f.icon !== 'finance' && f.icon !== 'live');
---

<section id="features" class="pf-section pf-section--m feat" aria-labelledby="features-title">
  <div class="pf-container">
    <div class="pf-head pf-head--split">
      <h2 id="features-title" class="pf-h2">Меньше рутины, больше готового</h2>
      <p class="pf-lead">
        Идеи, работа над ними и деньги в одном месте. Ты задаёшь направление, платформа
        доводит до результата.
      </p>
    </div>

    <div class="feat__switch" data-switch>
      <div class="feat__tabs" role="tablist" aria-label="Возможности ProjectsFlow">
        {
          PANELS.map((p, i) => (
            <button
              type="button"
              role="tab"
              class="feat__tab"
              id={`feat-tab-${p.key}`}
              aria-controls={`feat-panel-${p.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? undefined : -1}
            >
              {p.tab}
            </button>
          ))
        }
      </div>

      {
        PANELS.map((p) => {
          const f = featureOf(p.key);
          return (
            <section
              class="feat__panel"
              role="tabpanel"
              id={`feat-panel-${p.key}`}
              aria-labelledby={`feat-tab-${p.key}`}
            >
              <div class="feat__text">
                <h3 class="feat__title">{f.title}</h3>
                <p class="feat__body">{f.body}</p>
              </div>
              <figure class="feat__visual" data-slot={`feat-${p.key}`} data-kind="product" data-alt={p.caption}>
                <div class:list={['feat__windows', p.views.length > 1 && 'feat__windows--pair']}>
                  {p.views.map((v) => <Screenshots view={v} />)}
                </div>
                <figcaption class="feat__caption" data-keep>{p.caption}</figcaption>
              </figure>
            </section>
          );
        })
      }
    </div>
    <p class="feat__sample">Цифры и задачи в окнах для примера: у тебя будут свои.</p>

    <div class="feat__more">
      <h3 class="feat__more-title">Ещё в ProjectsFlow</h3>
      <dl class="feat__more-list">
        {
          more.map((f) => (
            <div class="feat__more-item">
              <dt>{f.title}</dt>
              <dd>{f.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Вкладки: квадратные клетки на общих рамках 2px; выбранная — чернилами. */
  .feat__tabs { display: none; }
  :global(.js) .feat__tabs {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    margin-block-end: var(--space-lg);
  }
  .feat__tab {
    flex: 0 0 auto;
    min-block-size: 48px;
    padding-inline: var(--space-lg);
    border: var(--rule-bar) solid var(--color-ink);
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 800;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-micro) steps(1), color var(--dur-micro) steps(1);
  }
  .feat__tab + .feat__tab { margin-inline-start: calc(-1 * var(--rule-bar)); }
  .feat__tab[aria-selected='true'] { background: var(--color-ink); color: var(--color-paper); }
  .feat__tab:focus-visible { position: relative; z-index: var(--z-raised); outline-offset: 3px; }
  .feat__tab:active { transform: translateY(1px); }
  @media (hover: hover) and (pointer: fine) {
    .feat__tab[aria-selected='false']:hover { background: var(--color-paper-2); }
  }

  /* Панель: текст на пяти колонках, окна на семи. Без JS панели идут друг за другом. */
  .feat__panel {
    display: grid;
    gap: var(--space-xl) var(--gap-columns);
    align-items: start;
  }
  .feat__panel + .feat__panel { margin-block-start: var(--space-2xl); }
  :global(.js) .feat__panel + .feat__panel { margin-block-start: 0; }
  :global(.js) .feat__panel[data-hidden] { display: none; }
  @media (min-width: 60rem) {
    .feat__panel { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
  }
  .feat__text {
    display: grid;
    gap: var(--space-md);
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-bar) solid var(--color-ink);
  }
  .feat__title { font-size: var(--text-xl); }
  .feat__body { max-inline-size: 40ch; color: var(--color-ink-2); }

  .feat__visual {
    margin: 0;
    background: transparent;
  }
  .feat__windows {
    display: grid;
    gap: var(--space-md);
    align-items: start;
  }
  /* Пара окон — ступенькой, без перекрытия: фрагмент слева прижат к низу, главное окно
     справа выше него. Ничего не закрывает чужой текст. */
  @media (min-width: 48rem) {
    .feat__windows--pair {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
    }
    .feat__windows--pair > :global(:first-child) { margin-block-start: var(--space-2xl); }
  }
  .feat__caption {
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .feat__sample {
    margin-block-start: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* Ещё — ряд из четырёх клеток под линией 2px, между клетками тонкие линии. */
  .feat__more {
    margin-block-start: var(--space-3xl);
  }
  .feat__more-title { font-size: var(--text-title); }
  .feat__more-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    margin: var(--space-lg) 0 0;
    border-block-start: var(--rule-bar) solid var(--color-ink);
  }
  .feat__more-item {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-lg) var(--space-lg) var(--space-lg) 0;
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }
  @media (min-width: 60rem) {
    .feat__more-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .feat__more-item { border-block-end: 0; padding-inline-start: var(--space-lg); }
    .feat__more-item:first-child { padding-inline-start: 0; }
    .feat__more-item + .feat__more-item { border-inline-start: var(--rule-hair) solid var(--color-rule); }
  }
  .feat__more-item dt {
    font-size: var(--text-md);
    font-weight: 800;
  }
  .feat__more-item dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
</style>

<script>
  // Вкладки «Меньше рутины»: клик и стрелки переключают панель, Home/End — к краям.
  document.querySelectorAll<HTMLElement>('[data-switch]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (next: HTMLButtonElement, focus: boolean): void => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        panel?.toggleAttribute('data-hidden', !on);
      }
      if (focus) next.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (e) => {
        const to =
          e.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length]
          : e.key === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length]
          : e.key === 'Home' ? tabs[0]
          : e.key === 'End' ? tabs[tabs.length - 1]
          : null;
        if (!to) return;
        e.preventDefault();
        select(to, true);
      });
    });
    const first = tabs[0];
    if (first) select(first, false);
  });
</script>
