---
// Путь задачи от идеи до запуска. У каждого шага — метка статуса из приложения: те же
// цвета, что на доске в hero (черновик → AI делает → на утверждении → готово).
const steps = [
  {
    title: 'Опиши идею',
    body: 'Просто словами расскажи, что хочешь получить. Никаких форм с двадцатью полями.',
    tag: 'Черновик',
    tone: 'pf-tone-gray',
  },
  {
    title: 'AI берётся за дело',
    body: 'Платформа разбивает задумку на задачи и доводит их до готового результата сама.',
    tag: 'AI делает',
    tone: 'pf-tone-queue',
  },
  {
    title: 'Смотришь, как растёт',
    body: 'Видишь прогресс в реальном времени и сколько всё стоит, в рублях. Готовое приходит тебе на утверждение.',
    tag: 'На утверждении',
    tone: 'pf-tone-approval',
  },
  {
    title: 'Запускаешь',
    body: 'Готовый продукт — у тебя на руках. Дальше развивай новыми идеями, когда захочешь.',
    tag: 'Готово',
    tone: 'pf-tone-done',
  },
];
---

<section id="how" class="pf-section">
  <div class="pf-container">
    <div class="pf-head">
      <h2 class="pf-h2">Четыре шага&nbsp;— от идеи до запуска</h2>
      <p class="pf-lead">
        Ты остаёшься на уровне идей и решений. Всё, что между задумкой и готовым продуктом,
        платформа берёт на себя.
      </p>
    </div>

    <ol class="how">
      {
        steps.map((s, i) => (
          <li class="how__step">
            <span class="how__n" aria-hidden="true">{i + 1}</span>
            <span class={`pf-tag ${s.tone} how__tag`}>
              <span class="pf-tag__text">{s.tag}</span>
            </span>
            <h3 class="how__title">{s.title}</h3>
            <p class="how__body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Дорожка: шаги стоят на одной линии, номер — на линии. На телефоне — столбиком. */
  .how {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .how__step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-block-start: 1.75rem;
    border-block-start: 1px solid oklch(var(--border));
    position: relative;
  }
  .how__n {
    position: absolute;
    inset-block-start: -0.8125rem;
    inset-inline-start: 0;
    display: grid;
    place-items: center;
    inline-size: 1.625rem;
    block-size: 1.625rem;
    border: 1px solid oklch(var(--border));
    border-radius: 50%;
    background: oklch(var(--background));
    font-size: var(--text-ui);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: oklch(var(--foreground));
  }
  .how__title {
    margin-block-start: 0.25rem;
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    color: oklch(var(--foreground));
  }
  .how__body {
    max-inline-size: 30rem;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: oklch(var(--muted-foreground));
  }
</style>
