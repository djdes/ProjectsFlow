---
import Logo from './Logo.astro';
import { NAV_LINKS } from '@/data/nav';

// Лендинг и SPA отдаются одним Express'ом в prod → относительные пути работают.
// В dev (Astro :4321, Vite :5173) можно задать `PUBLIC_APP_URL=http://localhost:5173`.
const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');
// Раздел блога подсвечиваем как текущий на /blog и в статьях.
const inBlog = Astro.url.pathname.startsWith('/blog');
const isCurrent = (href: string): boolean => inBlog && href === '/blog';
---

<!-- Мастхед: слово по центру над линией 2px, слева пункты, справа вход. На узких — слово
     слева, пункты и вход в панели бургера. -->
<header class="pf-nav">
  <nav class="pf-container pf-nav__inner" aria-label="Основная навигация">
    <Logo class="pf-nav__logo" />

    <div class="pf-nav__links">
      {NAV_LINKS.map((l) => (
        <a href={l.href} class="pf-nav__link" aria-current={isCurrent(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </div>

    <div class="pf-nav__actions">
      {/* Десктопные кнопки; на мобиле действия живут в панели бургера. */}
      <div class="pf-nav__cta">
        <a href={`${appBase}/login`} data-auth-anon class="pf-nav__link pf-nav__login">Войти</a>
        <a href={`${appBase}/register`} data-auth-anon class="pf-btn pf-btn--primary">Создать аккаунт</a>
        {/* Видна, если /api/auth/me ответил 200 (BaseLayout ставит html[data-auth="authed"]). */}
        <a href={`${appBase}/`} data-auth-authed class="pf-btn pf-btn--primary">Открыть приложение</a>
      </div>

      <button
        type="button"
        class="pf-nav__burger"
        aria-label="Меню"
        aria-expanded="false"
        aria-controls="pf-nav-mobile"
        data-burger
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="pf-nav__mobile" id="pf-nav-mobile" data-mobile-panel hidden>
    <div class="pf-container pf-nav__mobile-inner">
      {NAV_LINKS.map((l) => (
        <a
          href={l.href}
          class="pf-nav__mobile-link"
          aria-current={isCurrent(l.href) ? 'page' : undefined}
          data-mobile-close
        >
          {l.label}
        </a>
      ))}
      <div class="pf-nav__mobile-actions">
        <a href={`${appBase}/register`} data-auth-anon class="pf-btn pf-btn--primary pf-btn--block">Создать аккаунт</a>
        <a href={`${appBase}/login`} data-auth-anon class="pf-btn pf-btn--secondary pf-btn--block">Войти</a>
        <a href={`${appBase}/`} data-auth-authed class="pf-btn pf-btn--primary pf-btn--block">Открыть приложение</a>
      </div>
    </div>
  </div>
</header>

<style>
  .pf-nav {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky-nav);
    background: var(--color-paper);
    border-block-end: var(--rule-bar) solid var(--color-ink);
  }
  .pf-nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    min-block-size: var(--nav-h);
  }
  .pf-nav__links { display: none; }
  .pf-nav__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: var(--space-xs);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-micro) steps(1);
  }
  .pf-nav__link[aria-current='page'] {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .pf-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-inline-start: auto;
  }
  .pf-nav__cta { display: none; }

  /* Бургер — только на узких экранах: три полосы 2px в квадратной клетке. */
  .pf-nav__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2xs);
    inline-size: 48px;
    block-size: 48px;
    padding-inline: 12px;
    border: var(--rule-bar) solid var(--color-ink);
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }
  .pf-nav__burger:active { background: var(--color-paper-2); }
  .pf-nav__burger span {
    display: block;
    block-size: 2px;
    background: currentColor;
  }
  .pf-nav__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .pf-nav__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .pf-nav__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  @media (prefers-reduced-motion: no-preference) {
    .pf-nav__burger span { transition: transform var(--dur-short) var(--ease-out), opacity var(--dur-micro) var(--ease-out); }
  }

  /* Мобильная панель под полосой. */
  .pf-nav__mobile {
    border-block-start: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper);
  }
  .pf-nav__mobile[hidden] { display: none; }
  .pf-nav__mobile-inner {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-xs) var(--space-lg);
  }
  .pf-nav__mobile-link {
    display: flex;
    align-items: center;
    min-block-size: 52px;
    border-block-end: var(--rule-hair) solid var(--color-rule);
    color: var(--color-ink);
    font-size: var(--text-lg);
    font-stretch: var(--stretch-display);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    text-decoration: none;
  }
  .pf-nav__mobile-link[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  .pf-nav__mobile-link:active { background: var(--color-paper-2); }
  .pf-nav__mobile-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-block-start: var(--space-lg);
  }

  @media (hover: hover) and (pointer: fine) {
    .pf-nav__link:hover { color: var(--color-accent); }
    .pf-nav__burger:hover { background: var(--color-paper-2); }
  }

  /* Средние экраны: кнопки в полосе, пункты — в бургере. */
  @media (min-width: 48rem) {
    .pf-nav__cta { display: flex; align-items: center; gap: var(--space-xs); }
    .pf-nav__mobile-actions { display: none; }
  }

  /* Пункты в полосе: слово слева, пункты за ним, вход справа. */
  @media (min-width: 75rem) {
    .pf-nav__links {
      display: flex;
      align-items: center;
      gap: var(--space-2xs);
    }
    .pf-nav__burger { display: none; }
    .pf-nav__mobile { display: none !important; }
  }
  /* Мастхед, когда пункты помещаются слева от центра: слово ровно посередине. */
  @media (min-width: 90rem) {
    .pf-nav__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }
    .pf-nav__links {
      grid-column: 1;
      grid-row: 1;
      margin-inline-start: calc(-1 * var(--space-xs));
    }
    .pf-nav__logo { grid-column: 2; grid-row: 1; }
    .pf-nav__actions { grid-column: 3; grid-row: 1; justify-content: flex-end; }
  }
</style>

<script>
  // Раскрытие мобильного меню: Esc закрывает и возвращает фокус на бургер.
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');

  const closePanel = (returnFocus = false): void => {
    if (!burger || !panel) return;
    const wasOpen = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
    if (returnFocus && wasOpen) burger.focus();
  };
  if (burger && panel) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    panel.querySelectorAll('[data-mobile-close]').forEach((el) =>
      el.addEventListener('click', () => closePanel()),
    );
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel(true);
    });
    window.matchMedia('(min-width: 75rem)').addEventListener('change', (e) => {
      if (e.matches) closePanel();
    });
  }
</script>
