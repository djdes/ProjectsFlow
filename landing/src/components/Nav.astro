---
import Logo from './Logo.astro';
import { NAV_LINKS } from '@/data/nav';

// Лендинг и SPA отдаются одним Express'ом в prod → относительные пути работают.
// В dev (Astro :4321, Vite :5173) можно задать `PUBLIC_APP_URL=http://localhost:5173`.
const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');
// Раздел блога подсвечиваем как текущий на /blog и в статьях.
const inBlog = Astro.url.pathname.startsWith('/blog');
const isCurrent = (href: string): boolean => inBlog && href === '/blog';
---

<header class="pf-nav">
  <nav class="pf-container pf-nav__inner" aria-label="Основная навигация">
    <Logo />

    <div class="pf-nav__links">
      {NAV_LINKS.map((l) => (
        <a href={l.href} class="pf-nav__link" aria-current={isCurrent(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </div>

    <div class="pf-nav__actions">
      {/* Десктопные кнопки; на мобиле действия живут в панели бургера. */}
      <div class="pf-nav__cta">
        <a href={`${appBase}/login`} data-auth-anon class="pf-btn pf-btn--secondary">Войти</a>
        <a href={`${appBase}/register`} data-auth-anon class="pf-btn pf-btn--primary">Создать аккаунт</a>
        {/* Видна, если /api/auth/me ответил 200 (BaseLayout ставит html[data-auth="authed"]). */}
        <a href={`${appBase}/`} data-auth-authed class="pf-btn pf-btn--primary">Открыть приложение</a>
      </div>

      <button
        type="button"
        class="pf-nav__burger"
        aria-label="Меню"
        aria-expanded="false"
        aria-controls="pf-nav-mobile"
        data-burger
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <div class="pf-nav__mobile" id="pf-nav-mobile" data-mobile-panel hidden>
    <div class="pf-container pf-nav__mobile-inner">
      {NAV_LINKS.map((l) => (
        <a
          href={l.href}
          class="pf-nav__mobile-link"
          aria-current={isCurrent(l.href) ? 'page' : undefined}
          data-mobile-close
        >
          {l.label}
        </a>
      ))}
      <div class="pf-nav__mobile-actions">
        <a href={`${appBase}/register`} data-auth-anon class="pf-btn pf-btn--primary pf-btn--block">Создать аккаунт</a>
        <a href={`${appBase}/login`} data-auth-anon class="pf-btn pf-btn--secondary pf-btn--block">Войти</a>
        <a href={`${appBase}/`} data-auth-authed class="pf-btn pf-btn--primary pf-btn--block">Открыть приложение</a>
      </div>
    </div>
  </div>
</header>

<style>
  .pf-nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: oklch(var(--background));
    border-block-end: 1px solid oklch(var(--border));
  }
  .pf-nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    block-size: var(--nav-h);
  }
  .pf-nav__links {
    display: none;
    align-items: center;
    gap: 0.125rem;
  }
  .pf-nav__link {
    padding: 0.375rem 0.625rem;
    border-radius: var(--r-md);
    color: oklch(var(--muted-foreground));
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .pf-nav__link[aria-current='page'] { color: oklch(var(--foreground)); }
  .pf-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: auto;
  }
  .pf-nav__cta { display: none; }

  /* Бургер — только на узких экранах. */
  .pf-nav__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding-inline: 0.75rem;
    border: 0;
    border-radius: var(--r-md);
    background: transparent;
    color: oklch(var(--foreground));
    cursor: pointer;
  }
  .pf-nav__burger:active { background: var(--active); }
  .pf-nav__burger span {
    display: block;
    block-size: 1.5px;
    border-radius: 2px;
    background: currentColor;
  }
  .pf-nav__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .pf-nav__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .pf-nav__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }
  @media (prefers-reduced-motion: no-preference) {
    .pf-nav__burger span { transition: transform var(--dur) var(--ease-out), opacity var(--dur-fast) var(--ease-out); }
  }

  /* Мобильная панель под полосой. */
  .pf-nav__mobile {
    border-block-start: 1px solid oklch(var(--border));
    background: oklch(var(--background));
  }
  .pf-nav__mobile[hidden] { display: none; }
  .pf-nav__mobile-inner {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-block: 0.75rem 1rem;
  }
  .pf-nav__mobile-link {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 0.625rem;
    margin-inline: -0.625rem;
    border-radius: var(--r-md);
    color: oklch(var(--foreground));
    font-size: var(--text-base);
    font-weight: 500;
    text-decoration: none;
  }
  .pf-nav__mobile-link:active { background: var(--active); }
  .pf-nav__mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid oklch(var(--border));
  }

  @media (hover: hover) and (pointer: fine) {
    .pf-nav__link:hover { background: var(--hover); color: oklch(var(--foreground)); }
    .pf-nav__burger:hover { background: var(--hover); }
    .pf-nav__mobile-link:hover { background: var(--hover); }
  }

  /* Десктоп: ссылки и кнопки в полосе, бургер и панель скрыты. */
  @media (min-width: 880px) {
    .pf-nav__links { display: flex; }
    .pf-nav__cta { display: flex; align-items: center; gap: 0.5rem; }
    .pf-nav__burger { display: none; }
    .pf-nav__mobile { display: none !important; }
  }
</style>

<script>
  // Раскрытие мобильного меню: Esc закрывает и возвращает фокус на бургер.
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');

  const closePanel = (returnFocus = false): void => {
    if (!burger || !panel) return;
    const wasOpen = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
    if (returnFocus && wasOpen) burger.focus();
  };
  if (burger && panel) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    panel.querySelectorAll('[data-mobile-close]').forEach((el) =>
      el.addEventListener('click', () => closePanel()),
    );
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel(true);
    });
    window.matchMedia('(min-width: 880px)').addEventListener('change', (e) => {
      if (e.matches) closePanel();
    });
  }
</script>
