---
// Тизер блога на главной: последние 3 статьи строками указателя (дата, тема, заголовок,
// время чтения) + ссылка на весь блог. Вся строка кликабельна через ссылку заголовка.
import { getCollection } from 'astro:content';
import { readingMinutes, formatDate } from '@/lib/blog';
import { nbspDash } from '@/lib/typo';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((p) => ({ slug: p.id, minutes: readingMinutes(p.body ?? ''), ...p.data }));
---

<section id="blog" class="pf-section blog-teaser" aria-labelledby="blog-title">
  <div class="pf-container">
    <div class="blog-teaser__head">
      <h2 id="blog-title" class="pf-h2">Идеи и практика для тех, кто строит</h2>
      <a href="/blog" class="pf-link blog-teaser__all">Все статьи</a>
    </div>

    <ul class="blog-teaser__rows">
      {
        posts.map((p) => (
          <li class="pf-card blog-teaser__row">
            <time class="blog-teaser__date" datetime={p.date.toISOString()}>{formatDate(p.date)}</time>
            <span class="blog-teaser__topic">{p.topic}</span>
            <div class="blog-teaser__main">
              <h3 class="blog-teaser__title">
                <a class="pf-card-link blog-teaser__link" href={`/blog/${p.slug}`}>{nbspDash(p.title)}</a>
              </h3>
              {p.description && <p class="blog-teaser__desc">{p.description}</p>}
            </div>
            <span class="blog-teaser__min">{p.minutes} мин</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .blog-teaser__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    margin-block-end: var(--space-2xl);
  }
  .blog-teaser__all {
    font-size: var(--text-md);
    font-weight: 800;
    white-space: nowrap;
  }

  .blog-teaser__rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--rule-bar) solid var(--color-ink);
  }
  .blog-teaser__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xs) var(--space-md);
    padding-block: var(--space-lg);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }
  .blog-teaser__date,
  .blog-teaser__topic,
  .blog-teaser__min {
    font-size: var(--text-sm);
    color: var(--color-muted);
    white-space: nowrap;
  }
  .blog-teaser__topic { justify-self: end; }
  .blog-teaser__main {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-xs);
  }
  .blog-teaser__title {
    max-inline-size: 36ch;
    font-size: var(--text-xl);
  }
  .blog-teaser__link {
    color: inherit;
    text-decoration: none;
  }
  .blog-teaser__desc {
    max-inline-size: 60ch;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .blog-teaser__min { display: none; }

  @media (min-width: 60rem) {
    .blog-teaser__row {
      grid-template-columns: 11rem 9rem minmax(0, 1fr) 5rem;
      column-gap: var(--gap-columns);
      align-items: baseline;
      padding-block: var(--space-xl);
    }
    .blog-teaser__topic { justify-self: start; }
    .blog-teaser__main { grid-column: auto; }
    .blog-teaser__min { display: block; text-align: end; }
  }
  @media (hover: hover) and (pointer: fine) {
    .blog-teaser__row:hover .blog-teaser__title { color: var(--color-accent); }
  }
</style>
