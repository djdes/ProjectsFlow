---
// Тизер блога на главной: последние 3 статьи + ссылка на весь блог.
import { getCollection } from 'astro:content';
import { readingMinutes } from '@/lib/blog';
import PostCard from './PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((p) => ({ slug: p.id, minutes: readingMinutes(p.body ?? ''), ...p.data }));
---

<section id="blog" class="pf-section pf-section--alt">
  <div class="pf-container">
    <div class="blog-teaser__head">
      <h2 class="pf-h2">Идеи и практика для тех, кто строит</h2>
      <a href="/blog" class="pf-link blog-teaser__all">Все статьи</a>
    </div>

    <ul class="blog-teaser__grid">
      {
        posts.map((p) => (
          <li>
            <PostCard
              slug={p.slug}
              title={p.title}
              topic={p.topic}
              date={p.date}
              minutes={p.minutes}
              description={p.description}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .blog-teaser__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-block-end: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .blog-teaser__head .pf-h2 { max-inline-size: 40rem; }
  .blog-teaser__all {
    font-size: var(--text-md);
    font-weight: 500;
    white-space: nowrap;
  }
  .blog-teaser__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
