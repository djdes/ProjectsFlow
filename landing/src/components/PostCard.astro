---
// Карточка статьи блога: тема, заголовок-ссылка (вся карточка кликабельна через неё),
// описание, дата и время чтения. Список блога и «Читайте также»; на главной статьи идут
// строками (BlogTeaser.astro). Wayfind: квадратная табличка в рамке 2px.
import { formatDate } from '@/lib/blog';
import { nbspDash } from '@/lib/typo';

interface Props {
  slug: string;
  title: string;
  topic: string;
  date: Date;
  minutes: number;
  description?: string;
  /** Уровень заголовка: h2 в списке блога, h3 внутри секций. */
  level?: 2 | 3;
}
const { slug, title, topic, date, minutes, description, level = 3 } = Astro.props as Props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<article class="pf-card post-card">
  <span class="pf-pill post-card__topic">{topic}</span>
  <Heading class="post-card__title">
    <a class="pf-card-link post-card__link" href={`/blog/${slug}`}>{nbspDash(title)}</a>
  </Heading>
  {description && <p class="post-card__desc">{description}</p>}
  <p class="post-card__meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span>{minutes} мин чтения</span>
  </p>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    block-size: 100%;
    padding: var(--space-lg);
    border: var(--rule-bar) solid var(--color-ink);
    background: var(--color-paper-3);
    transition: background-color var(--dur-micro) steps(1);
  }
  .post-card__topic { color: var(--color-ink-2); }
  .post-card__title {
    max-inline-size: none;
    font-size: var(--text-lg);
    line-height: 1.3;
  }
  .post-card__link {
    color: inherit;
    text-decoration: none;
  }
  .post-card__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: clip;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
    inline-size: 100%;
    margin-block-start: auto;
    padding-block-start: var(--space-sm);
    border-block-start: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .post-card:has(.pf-card-link):hover { background: var(--color-paper-2); }
  }
</style>
