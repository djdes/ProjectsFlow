---
// Пара кнопок «Создать аккаунт» + «Войти» с учётом входа (сейчас на страницах не используется).
// URL'ы относительные — лендинг и SPA отдаются одним Express'ом (см. server/src/presentation/http.ts).
// Для dev'а (Astro :4321 ≠ Vite :5173) можно задать `PUBLIC_APP_URL` в .env лендинга.

const appBase = (import.meta.env.PUBLIC_APP_URL ?? '').replace(/\/+$/, '');

interface Props {
  size?: 'lg' | 'md';
}
const { size = 'lg' } = Astro.props as Props;
const sizeCls = size === 'lg' ? 'pf-btn--lg' : '';
---

<div class="authcta">
  <a href={`${appBase}/register`} data-auth-anon class:list={['pf-btn', 'pf-btn--primary', sizeCls]}>Создать аккаунт</a>
  <a href={`${appBase}/login`} data-auth-anon class:list={['pf-btn', 'pf-btn--secondary', sizeCls]}>Войти</a>
  <a href={`${appBase}/`} data-auth-authed class:list={['pf-btn', 'pf-btn--primary', sizeCls]}>Открыть приложение</a>
</div>

<style>
  .authcta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
</style>
